diff --git a/plugins/prismantis/tests/rice.test.tsx b/plugins/prismantis/tests/rice.test.tsx
new file mode 100644
index 0000000..0139762
--- /dev/null
+++ b/plugins/prismantis/tests/rice.test.tsx
@@ -0,0 +1,84 @@
+import { expect, test } from 'claude-code/testing'
+
+import { PRESETS } from '../hooks/presets'
+import { contrast } from '../hooks/render'
+import type { Theme } from '../hooks/theme'
+import { TOKENS, pickTheme, resolveStyle } from '../hooks/theme'
+
+const RICE: Record<string, { bg: string; accent: string }> = {
+  ember: { bg: '#0a0908', accent: '#ff7a1a' },
+  amber: { bg: '#0a0a07', accent: '#ffd60a' },
+  crimson: { bg: '#0a0808', accent: '#ff4040' },
+}
+
+const mount = (text: string) => ({
+  plugin: 'prismantis',
+  component: 'AssistantMessage' as const,
+  props: { text, isFirstOfReply: true },
+  viewport: { columns: 100, rows: 40 },
+  surface: 'terminal' as const,
+})
+
+const hue = (hex: string) => {
+  const [r, g, b] = [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16) / 255) as [number, number, number]
+  const max = Math.max(r, g, b), min = Math.min(r, g, b), d = max - min
+  if (d < 0.08) return null
+  const h = max === r ? ((g - b) / d) % 6 : max === g ? (b - r) / d + 2 : (r - g) / d + 4
+  return (h * 60 + 360) % 360
+}
+
+for (const [name, { accent }] of Object.entries(RICE)) {
+  test(`the ${name} preset is a theme you can pick, with every slot filled and the accent on headings and table headers`, async () => {
+    const theme = (PRESETS as Record<string, Theme>)[name]!
+    expect(TOKENS.filter(k => !theme[k])).toEqual([])
+    expect(pickTheme(name)).toBe(name)
+    const style = resolveStyle({ theme: name })
+    expect(style.theme.heading).toBe(accent)
+    expect(style.theme.tableHeader).toBe(accent)
+  })
+
+  test(`the ${name} preset has no blue, purple or cyan in it (green only for added diff lines)`, async () => {
+    const theme = (PRESETS as Record<string, Theme>)[name]!
+    const cool = Object.entries(theme).filter(([k, v]) => k !== 'diffAdded' && hue(v!) !== null && hue(v!)! > 150 && hue(v!)! < 300)
+    expect(cool).toEqual([])
+  })
+
+  test(`the ${name} preset keeps detail colors apart: bold, inline code, paths, links and numbers are five different shades`, async () => {
+    const t = (PRESETS as Record<string, Theme>)[name]!
+    expect(new Set([t.strong, t.inlineCode, t.path, t.link, t.number]).size).toBe(5)
+    expect(contrast(t.codeText!, RICE[name]!.bg) >= 10).toBe(true)
+  })
+}
+
+test('bar headings put a ▍ in the heading color before H1 and H2, underline only H1, and leave H3 as bold accent text', { options: { theme: 'ember', headingStyle: 'bar', copyButtons: false } }, async $ => {
+  const t = PRESETS.ember
+  const ui = await $.ui.mount(mount('# Top\n\n## Section\n\n### Detail'))
+  const bars = await ui.findAll({ type: 'Text', text: /^▍ $/ })
+  expect(bars.length).toBe(2)
+  expect(bars.every(b => b.props.color === t.heading)).toBe(true)
+  const top = await ui.find({ type: 'Text', text: /^Top$/ })
+  const section = await ui.find({ type: 'Text', text: /^Section$/ })
+  const detail = await ui.find({ type: 'Text', text: /^Detail$/ })
+  expect([top?.props.bold, top?.props.underline, top?.props.color]).toEqual([true, true, t.heading])
+  expect([section?.props.bold, section?.props.underline, section?.props.color]).toEqual([true, false, t.heading])
+  expect([detail?.props.bold, detail?.props.color]).toEqual([true, t.accent])
+  await ui.unmount()
+})
+
+test('alerts take the rice preset alert colors, and keep the named GitHub colors in upstream presets', { options: { theme: 'ember', copyButtons: false } }, async $ => {
+  const ui = await $.ui.mount(mount('> [!NOTE]\n> one\n\n> [!WARNING]\n> two'))
+  expect((await ui.find({ type: 'Text', text: /^Note$/ }))?.props.color).toBe(PRESETS.ember.alertNote)
+  expect((await ui.find({ type: 'Text', text: /^Warning$/ }))?.props.color).toBe(PRESETS.ember.alertWarning)
+  await ui.unmount()
+})
+
+test('an upstream preset still draws a note in named blue', { options: { theme: 'nord', copyButtons: false } }, async $ => {
+  const ui = await $.ui.mount(mount('> [!NOTE]\n> one'))
+  expect((await ui.find({ type: 'Text', text: /^Note$/ }))?.props.color).toBe('blue')
+  await ui.unmount()
+})
+
+test('an unknown heading style still falls back to banner', async () => {
+  expect(resolveStyle({ headingStyle: 'nope' }).headingStyle).toBe('banner')
+  expect(resolveStyle({ headingStyle: 'bar' }).headingStyle).toBe('bar')
+})
