{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "model": "sonnet",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/tab-title.mjs\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/tab-title.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/tab-title.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "exec \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/claude-hud/statusline.cmd\""
  },
  "enabledPlugins": {
    "getlayers@getlayers": true,
    "claude-hud@kasasree-mods": true,
    "token-weather@kasasree-mods": false,
    "flightdeck@kasasree-mods": true,
    "skins@kasasree-mods": true,
    "image-view@kasasree-mods": true,
    "filetree@kasasree-mods": true
  },
  "extraKnownMarketplaces": {
    "getlayers": {
      "source": {
        "source": "github",
        "repo": "textura-agency/getlayers-plugin"
      }
    },
    "kasasree-mods": {
      "source": {
        "source": "directory",
        "path": "C:\\Users\\Kasasree\\Projects\\claude-mods-local"
      }
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Pondering",
      "Noodling",
      "Cogitating",
      "Percolating",
      "Ruminating",
      "Mulling it over",
      "Untangling",
      "Cross-referencing",
      "Reading the room",
      "Spelunking the codebase",
      "Connecting the dots",
      "Following the thread",
      "Weighing options",
      "Sketching it out",
      "Tidying up",
      "Almost there"
    ]
  },
  "spinnerTipsOverride": {
    "excludeDefault": true,
    "tips": [
      "Ctrl+J inserts a newline without sending",
      "Ctrl+O then [ dumps the chat into native scrollback",
      "claude --safe-mode starts a session with every mod switched off"
    ]
  },
  "maxProseWidth": 100,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "pluginConfigs": {
    "flightdeck@kasasree-mods": {
      "options": {
        "openOnStart": true,
        "statusLine": false
      }
    },
    "filetree@kasasree-mods": {
      "options": {
        "start": "off"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:claude",
  "agentPushNotifEnabled": true
}
