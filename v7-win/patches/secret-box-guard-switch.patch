+// LOCAL PATCH (kasasree-mods) tests: /secret-box and the `enabled` option.
+import { expect, test } from 'claude-code/testing'
+
+const STRIPE = 'sk_' + 'live_' + 'a1B2c3D4e5F6g7H8i9J0k1L2m3N4'
+
+type Answer = { deny?: string; result?: unknown }
+const call = async ($: any, input: Record<string, unknown>) => (await $.tool.call(input as never)) as Answer
+const toggle = async ($: any, args: string, origin?: Record<string, unknown>) =>
+  String((await $.command.run({ command: 'secret-box', args, ...(origin ? { origin } : {}) })).text)
+
+function stubs(on: any, opts: { output?: string; staged?: string; seen?: string[] } = {}) {
+  on('tool.call', (_$: unknown, e: Record<string, unknown>) => {
+    opts.seen?.push(String(e.command ?? ''))
+    return { result: opts.output ?? 'ran' }
+  })
+  on('process.run', () => ({ value: { exitCode: 0, stdout: opts.staged ?? '', stderr: '' } }))
+  on('session.cwd', () => ({ value: '/repo' }))
+  on('fs.exists', () => ({ value: false }))
+  on('fs.read', () => ({ value: '' }))
+}
+
+test('it starts on: a key is hidden and committing .env is refused', async ($, on) => {
+  stubs(on, { output: `token ${STRIPE}`, staged: '.env\n' })
+  expect(String((await call($, { tool: 'Bash', command: 'node pay.js' })).result)).not.toContain(STRIPE)
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git commit -m wip' })).deny)).toBe(true)
+  expect(await toggle($, 'status')).toContain('secret-box is on')
+})
+
+test('enabled off: it starts off, and /secret-box on brings all of it back', { options: { enabled: false } }, async ($, on) => {
+  stubs(on, { output: `token ${STRIPE}`, staged: '.env\n' })
+  expect(String((await call($, { tool: 'Bash', command: 'node pay.js' })).result)).toContain(STRIPE)
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git commit -m wip' })).deny)).toBe(false)
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git add .env' })).deny)).toBe(false)
+  expect(await toggle($, 'status')).toContain('secret-box is off')
+
+  expect(await toggle($, 'on')).toContain('secret-box is on')
+  expect(String((await call($, { tool: 'Bash', command: 'node pay.js' })).result)).not.toContain(STRIPE)
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git commit -m wip' })).deny)).toBe(true)
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git add .env' })).deny)).toBe(true)
+})
+
+for (const kind of ['composer', 'bridge']) {
+  test(`the person, through ${kind}, can turn it off and flip it back`, async ($, on) => {
+    stubs(on, { output: `token ${STRIPE}`, staged: '.env\n' })
+    expect(await toggle($, 'off', { kind })).toContain('secret-box is off')
+    expect(String((await call($, { tool: 'Bash', command: 'node pay.js' })).result)).toContain(STRIPE)
+    expect(Boolean((await call($, { tool: 'Bash', command: 'git commit -m wip' })).deny)).toBe(false)
+    expect(await toggle($, '', { kind })).toContain('secret-box is on')
+    expect(String((await call($, { tool: 'Bash', command: 'node pay.js' })).result)).not.toContain(STRIPE)
+    expect(await toggle($, '', { kind })).toContain('secret-box is off')
+  })
