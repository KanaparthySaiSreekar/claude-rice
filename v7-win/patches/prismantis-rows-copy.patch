diff --git a/plugins/prismantis/tests/kasasree.test.tsx b/plugins/prismantis/tests/kasasree.test.tsx
new file mode 100644
index 0000000..4d8b4ad
--- /dev/null
+++ b/plugins/prismantis/tests/kasasree.test.tsx
@@ -0,0 +1,135 @@
+// LOCAL PATCH (kasasree-mods) tests: toolOutput 'rows' and copyFeedback 'button'.
+import type { On } from 'claude-code'
+import { expect, mock, test } from 'claude-code/testing'
+
+import { clipboardEnv, recordCopies, recordToasts, startSession } from './clipboard-env'
+
+const engine = (on: On) =>
+  on('ui.render', ($, e) => {
+    const { Text } = $.ui.resolve(e)
+    return <Text>engine</Text>
+  })
+
+const call = (tool: string, input: unknown, id: string) => ({ tool_use_id: id, tool, input, isRunning: false, isErrored: false, isInterrupted: false })
+const use = (tool: string, input: unknown, id: string) => ({ plugin: 'prismantis', surface: 'terminal' as const, component: 'ToolUse' as const, props: call(tool, input, id) })
+const result = (tool: string, id: string, output: unknown, isErrored = false) =>
+  ({ plugin: 'prismantis', surface: 'terminal' as const, component: 'ToolResult' as const, props: { tool_use_id: id, tool, output, isErrored } })
+
+test('toolOutput rows: a shell command or a fetch that worked shows its row and nothing under it', { options: { toolOutput: 'rows' } }, async ($, on) => {
+  engine(on)
+  for (const [tool, input, id, output] of [
+    ['Bash', { command: 'make test' }, 'r-1', { stdout: '42 passed\nall good', stderr: '' }],
+    ['PowerShell', { command: 'Get-ChildItem' }, 'r-2', { stdout: 'Mode  Name', stderr: '' }],
+    ['WebFetch', { url: 'https://example.com' }, 'r-3', 'page text'],
+  ] as const) {
+    const row = await $.ui.mount(use(tool, input, id))
+    const out = await $.ui.mount(result(tool, id, output))
+    expect(await out.find({ type: 'Text', text: /^engine$/ })).toBeUndefined()
+    expect(await out.find({ type: 'Text', text: /passed|Mode|page text/ })).toBeUndefined()
+    await out.unmount()
+    await row.unmount()
+  }
+})
+
+test('toolOutput rows: a failure keeps its last line, an edit keeps its diff, background and image results stay with the engine', { options: { toolOutput: 'rows' } }, async ($, on) => {
+  engine(on)
+  const failed = await $.ui.mount(result('Bash', 'f-1', 'Error: Exit code 1\ncat: missing.txt: No such file or directory', true))
+  expect(await failed.find({ type: 'Text', text: /No such file or directory$/ })).toBeDefined()
+  await failed.unmount()
+  const edit = await $.ui.mount(result('Edit', 'f-2', { stdout: 'not a diff' }))
+  expect(await edit.find({ type: 'Text', text: /^engine$/ })).toBeDefined()
+  await edit.unmount()
+  for (const [id, output] of [['f-3', { stdout: '', stderr: '', backgroundTaskId: 'task-7' }], ['f-4', { stdout: 'iVBORw0KGgo', stderr: '', isImage: true }]] as const) {
+    const out = await $.ui.mount(result('Bash', id, output))
+    expect(await out.find({ type: 'Text', text: /^engine$/ })).toBeDefined()
+    await out.unmount()
+  }
+})
+
+test('toolOutput rows: the row is the quiet one-liner, and an expanded group shows its results again', { options: { toolOutput: 'rows', toolStyle: 'classic' } }, async ($, on) => {
+  engine(on)
+  const row = await $.ui.mount(use('Bash', { command: 'make test' }, 'x-1'))
+  expect(await row.find({ type: 'Text', text: /^Ran make test$/ })).toBeDefined()
+  await row.unmount()
+  const group = await $.ui.mount({
+    plugin: 'prismantis',
+    surface: 'terminal',
+    component: 'ToolGroup',
+    props: { calls: [call('Bash', { command: 'make test' }, 'x-2')], isActive: false, isExpanded: true },
+  })
+  await group.unmount()
+  const out = await $.ui.mount(result('Bash', 'x-2', { stdout: '42 passed', stderr: '' }))
+  expect(await out.find({ type: 'Text', text: /^engine$/ })).toBeDefined()
+  await out.unmount()
+})
+
+for (const toolOutput of ['quiet', 'rows'] as const) {
+  test(`toolOutput ${toolOutput}: a collapsed group ${toolOutput === 'rows' ? 'shows no output under' : 'shows the first lines of'} a command that worked, and the last line of one that failed`, { options: { toolOutput, toolStyle: 'classic' } }, async $ => {
+    const worked = { ...call('Bash', { command: 'npm test' }, 'g-1'), output: { stdout: 'tests 19\npass 19\nfail 0', stderr: '' } }
+    const failed = { ...call('Bash', { command: 'node apply.mjs sunset' }, 'g-2'), isErrored: true, output: 'Exit code 1\nno palette "sunset"' }
+    const group = await $.ui.mount({
+      plugin: 'prismantis',
+      surface: 'terminal',
+      component: 'ToolGroup',
+      props: { calls: [worked, failed], isActive: false, isExpanded: false },
+    })
+    expect((await group.find({ type: 'Text', text: /pass 19/ })) !== undefined).toBe(toolOutput === 'quiet')
+    expect(await group.find({ type: 'Text', text: /no palette "sunset"$/ })).toBeDefined()
+    await group.unmount()
+  })
+}
+
+const reply = {
+  plugin: 'prismantis',
+  component: 'AssistantMessage' as const,
+  props: { text: 'Run this:\n\n```sh\nnpm test\n```', isFirstOfReply: true },
+  viewport: { columns: 100, rows: 40 },
+  surface: 'terminal' as const,
+}
+
+const labels = async (ui: { findAll: (q: { type: 'Button' }) => Promise<{ props: { label?: unknown } }[]> }) =>
+  (await ui.findAll({ type: 'Button' })).map(button => String(button.props.label))
+
+test('copyFeedback button: a copy flips that button to ✓ copied for a moment, with no toast', { options: { copyFeedback: 'button' } }, async ($, on) => {
+  const clock = mock.clock(on)
+  clipboardEnv(on, 'other')
+  const copies = recordCopies(on)
+  const toasts = recordToasts(on)
+  await startSession($, on)
+  const ui = await $.ui.mount(reply)
+  const before = await labels(ui)
+  await ui.press({ key: 'copy1' })
+  await clock.settle()
+  expect(copies).toEqual(['npm test'])
+  expect(toasts).toEqual([])
+  const after = await labels(ui)
+  expect(after.filter(label => label === '✓ copied')).toHaveLength(1)
+  expect(after.filter(label => label !== '✓ copied')).toEqual(before.filter(label => label !== '⧉ copy'))
+  await clock.advance(1500)
+  await clock.settle()
+  expect(await labels(ui)).toEqual(before)
+  await ui.unmount()
+})
+
+test('copyFeedback button: a failed copy still toasts its reason', { options: { copyFeedback: 'button' } }, async ($, on) => {
+  clipboardEnv(on, 'other')
+  on('ui.copy', () => ({ value: { isCopied: false as const, reason: 'no-clipboard' as const } }))
+  const toasts = recordToasts(on)
+  await startSession($, on)
+  const ui = await $.ui.mount(reply)
+  await ui.press({ key: 'copy1' })
+  expect(toasts).toEqual(['Copy failed: no-clipboard'])
+  expect((await labels(ui)).includes('✓ copied')).toBe(false)
+  await ui.unmount()
+})
+
+test('copyFeedback left at toast keeps the upstream toast', async ($, on) => {
+  clipboardEnv(on, 'other')
+  recordCopies(on)
+  const toasts = recordToasts(on)
+  await startSession($, on)
+  const ui = await $.ui.mount(reply)
+  await ui.press({ key: 'copy1' })
+  expect(toasts).toEqual(['Copied'])
+  await ui.unmount()
+})
