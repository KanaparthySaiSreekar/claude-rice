diff --git a/plugins/cockpit/tests/kasasree.test.tsx b/plugins/cockpit/tests/kasasree.test.tsx
index 9027dbd..c2230e7 100644
--- a/plugins/cockpit/tests/kasasree.test.tsx
+++ b/plugins/cockpit/tests/kasasree.test.tsx
@@ -1,6 +1,48 @@
-// LOCAL PATCH (kasasree-mods) tests: the `band` and `statusLine` options.
+// LOCAL PATCH (kasasree-mods) tests: the `band` and `statusLine` options, and the guard starting off.
 import { expect, mock, test } from 'claude-code/testing'
 
+const CALLS = [
+  ['a risky command', { tool: 'Bash', command: 'rm -rf build' }],
+  ['an edit to a secrets file', { tool: 'Write', file_path: '/repo/.env.local', content: 'KEY=1' }],
+] as const
+
+for (const [name, call] of CALLS) {
+  test(`the guard starts off: ${name} runs and nothing is asked`, async ($, on) => {
+    mock.clock(on, { now: 1_800_000_000_000 })
+    mock.store(on)
+    let asked = 0
+    let ran = 0
+    on('tool.call', { tool: 'AskUserQuestion' }, () => {
+      asked += 1
+      return { result: { answers: { q: 'Block it' } } }
+    })
+    on('tool.call', { tool: call.tool }, () => {
+      ran += 1
+      return { result: { stdout: '', stderr: '' } }
+    })
+    await $.tool.call(call as never)
+    expect(ran).toBe(1)
+    expect(asked).toBe(0)
+  })
+
+  test(`/cockpit-guard on and off: ${name} is asked about only while it is on`, async ($, on) => {
+    mock.clock(on, { now: 1_800_000_000_000 })
+    mock.store(on)
+    let asked = 0
+    on('tool.call', { tool: 'AskUserQuestion' }, () => {
+      asked += 1
+      return { result: { answers: { q: 'Block it' } } }
+    })
+    on('tool.call', { tool: call.tool }, () => ({ result: { stdout: '', stderr: '' } }))
+    expect((await $.command.run({ command: 'cockpit-guard', args: 'on' })).text).toContain('is on')
+    await $.tool.call(call as never)
+    expect(asked).toBe(1)
+    expect((await $.command.run({ command: 'cockpit-guard', args: 'off' })).text).toContain('is off')
+    await $.tool.call(call as never)
+    expect(asked).toBe(1)
+  })
+}
+
 const BAND = {
   plugin: 'cockpit',
   surface: 'terminal',
