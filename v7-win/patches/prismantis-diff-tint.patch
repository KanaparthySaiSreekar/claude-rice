@@ -133,3 +135,29 @@ test('copyFeedback left at toast keeps the upstream toast', async ($, on) => {
   expect(toasts).toEqual(['Copied'])
   await ui.unmount()
 })
+
+const RETRO = { diffAddedColor: '#98C25B', diffRemovedColor: '#E8553C' }
+const patch = { filePath: '/tmp/app.ts', structuredPatch: [{ oldStart: 4, newStart: 4, lines: [' const a = 1', '-const b = 2', '+const b = 3'] }] }
+const editCard = { plugin: 'prismantis', surface: 'terminal' as const, component: 'ToolResult' as const, props: { tool_use_id: 'e-1', tool: 'Edit', output: patch, isErrored: false } }
+
+test('diffTint color: the tint mixes the diff color as given, not its full hue, and code text keeps 4.5:1', () => {
+  const text = resolveStyle(RETRO).theme.codeText!
+  for (const color of [RETRO.diffAddedColor, RETRO.diffRemovedColor]) {
+    expect(diffTint(text, color, true)).toBe(tint('#000000', color, 0.3))
+    expect(diffTint(text, color, true)).not.toBe(diffTint(text, color))
+    expect(contrast(text, diffTint(text, color, true)!)).toBeGreaterThanOrEqual(4.5)
+    expect(diffTint(text, color)).toBe(tint('#000000', fullHue(color), 0.3))
+  }
+})
+
+for (const diffTintOption of [undefined, 'color'] as const) {
+  test(`an edit's diff card ${diffTintOption ? 'with diffTint color tints lines with the retro colors' : 'with diffTint left alone keeps the full-hue tint'}`, { options: { ...RETRO, ...(diffTintOption ? { diffTint: diffTintOption } : {}) } }, async ($, on) => {
+    engine(on)
+    const text = resolveStyle(RETRO).theme.codeText
+    const ui = await $.ui.mount(editCard)
+    const row = (re: RegExp) => ui.find({ type: 'Box', text: re })
+    expect((await row(/^5 \+ const b = 3$/))?.props.backgroundColor).toBe(diffTint(text, RETRO.diffAddedColor, diffTintOption === 'color'))
+    expect((await row(/^5 - const b = 2$/))?.props.backgroundColor).toBe(diffTint(text, RETRO.diffRemovedColor, diffTintOption === 'color'))
+    await ui.unmount()
+  })
+}
