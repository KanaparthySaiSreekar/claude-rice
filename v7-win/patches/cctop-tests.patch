+// LOCAL PATCH (kasasree-mods): openOnStart.
+test('openOnStart: an interactive start opens the pane with an empty or a closed store, on the saved view; never for -p', async () => {
+  for (const [store, view] of [[undefined, 'overview'], [{ pane: { open: false, view: 'files' } }, 'files']] as const) {
+    const { $, start } = boot({ options: { openOnStart: true }, ...(store ? { store } : {}) });
+    await start();
+    await settle();
+    await settle();
+    assert.deepEqual($.ui.opens, [{ id: 'cctop', title: 'cctop' }], JSON.stringify(store));
+    assert.deepEqual(stored($), { open: true, view });
+  }
+  const { $, start } = boot({ options: { openOnStart: true }, isInteractive: false });
+  await start();
+  await settle();
+  await settle();
+  assert.deepEqual($.ui.opens, []);
+});
+
+// LOCAL PATCH (kasasree-mods): Windows has USERPROFILE, not HOME.
+test('self-check: with HOME unset, USERPROFILE is home: self-check ok and the marker lands under it', async () => {
+  const $ = fakeEngine({ now: T0, env: { USERPROFILE: 'C:/Users/u' }, process: binaryScripts(), files: { [MANIFEST]: manifest } });
+  const { on, dispatch } = fakeOn($, { surface: SURFACE });
+  register(on, {});
+  await dispatch('session.start', { cwd: 'C:/Users/u/project', surface: 'terminal', isInteractive: true }, () => ({
+    cwd: 'C:/Users/u/project',
+  }));
+  await settle();
+  await settle();
+  const lines = $.ui.logs.filter((l) => l.startsWith('cctop: plugin '));
+  assert.deepEqual(lines, [`cctop: plugin ${PLUGIN_VERSION} (hooks contract ${TESTED_WITH}) loaded; self-check ok`]);
+  assert.ok($.fs.files.has(`C:/Users/u/.cctop/pane/${SESSION}.json`), JSON.stringify([...$.fs.files.keys()]));
+});
+
+// LOCAL PATCH (kasasree-mods): announce off keeps a passing self-check out of the transcript, never a failing one.
+test('announce off: a passing self-check goes to the debug log; a failing one still shows', async () => {
+  const { $, start } = boot({ options: { announce: false } });
+  await start();
+  await settle();
+  assert.equal($.ui.logs.filter((l) => l.startsWith('cctop: plugin ')).length, 0, JSON.stringify($.ui.logs));
+  assert.equal($.ui.debugLogs.filter((l) => l.includes('self-check ok')).length, 1, JSON.stringify($.ui.debugLogs));
+  const failing = fakeEngine({ now: T0, process: binaryScripts(), files: { [MANIFEST]: manifest } });
+  const { on, dispatch } = fakeOn(failing, { surface: SURFACE });
+  register(on, { announce: false });
+  await dispatch('session.start', { cwd: '/home/user/project', surface: 'terminal', isInteractive: true }, () => ({ cwd: '/home/user/project' }));
+  await settle();
+  assert.equal(failing.ui.logs.filter((l) => l.includes('self-check failed')).length, 1, JSON.stringify(failing.ui.logs));
+});
