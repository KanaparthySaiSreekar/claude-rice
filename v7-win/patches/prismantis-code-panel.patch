+
+// LOCAL PATCH (kasasree-mods) tests: codeStyle 'panel' and codePanelColor.
+const answer = (text: string) =>
+  ({ plugin: 'prismantis', component: 'AssistantMessage' as const, props: { text, isFirstOfReply: true }, viewport: { columns: 100, rows: 40 }, surface: 'terminal' as const })
+const WINGET = 'Run this:\n\n```\nwinget upgrade raphamorim.rio GitHub.cli\n```\n'
+const bands = async (ui: { findAll: (q: { type: string }) => Promise<{ props: Record<string, unknown> }[]> }, color: string) =>
+  (await ui.findAll({ type: 'Box' })).filter(b => b.props.backgroundColor === color && b.props.paddingY === 1)
+
+test('codeStyle panel: code sits on the ember band, no "── code" line, an untagged block shows no tag, and the command keeps its colors', { options: { theme: 'ember', codeStyle: 'panel', copyButtonStyle: 'hover' } }, async $ => {
+  const t = PRESETS.ember
+  const ui = await $.ui.mount(answer(WINGET))
+  expect((await bands(ui, '#1b1917')).length).toBe(1)
+  expect(await ui.find({ type: 'Text', text: /^── / })).toBeUndefined()
+  expect(await ui.find({ type: 'Text', text: /^code$/ })).toBeUndefined()
+  expect((await ui.find({ type: 'Text', text: /^winget$/ }))?.props.color).toBe(t.codeCommand)
+  expect((await ui.findAll({ type: 'Button' })).length > 0).toBe(true)
+  await ui.unmount()
+})
+
+test('codeStyle panel: a tagged block names its language, dim, beside the code', { options: { theme: 'ember', codeStyle: 'panel' } }, async $ => {
+  const ui = await $.ui.mount(answer('```powershell\nGet-ChildItem -Force\n```\n\n```ts\nconst a = 1\n```'))
+  expect((await bands(ui, '#1b1917')).length).toBe(2)
+  for (const lang of ['powershell', 'ts']) expect((await ui.find({ type: 'Text', text: new RegExp(`^${lang}$`) }))?.props.color).toBe(PRESETS.ember.codeComment)
+  expect(await ui.find({ type: 'Text', text: /^── / })).toBeUndefined()
+  await ui.unmount()
+})
+
+test('codePanelColor picks the band; a theme without a panel color uses its rule color; the rule style keeps upstream', async () => {
+  expect(resolveStyle({ theme: 'amber', codeStyle: 'panel' }).codePanel).toBe('#1b1a14')
+  expect(resolveStyle({ theme: 'ember', codeStyle: 'panel', codePanelColor: '#222222' }).codePanel).toBe('#222222')
+  expect(resolveStyle({ theme: 'nord', codeStyle: 'panel' }).codePanel).toBe(PRESETS.nord.rule)
+  expect(resolveStyle({ theme: 'ember' }).codeStyle).toBe('rule')
+  expect(resolveStyle({ theme: 'ember', codeStyle: 'boxed' }).codeStyle).toBe('rule')
+})
+
+test('codeStyle left at rule keeps the "── code" line and no band', { options: { theme: 'ember' } }, async $ => {
+  const ui = await $.ui.mount(answer(WINGET))
+  expect(await ui.find({ type: 'Text', text: /^── code$/ })).toBeDefined()
+  expect((await bands(ui, '#1b1917')).length).toBe(0)
+  await ui.unmount()
+})
