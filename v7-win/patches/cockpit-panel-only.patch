diff --git a/plugins/cockpit/tests/kasasree.test.tsx b/plugins/cockpit/tests/kasasree.test.tsx
new file mode 100644
index 0000000..9027dbd
--- /dev/null
+++ b/plugins/cockpit/tests/kasasree.test.tsx
@@ -0,0 +1,38 @@
+// LOCAL PATCH (kasasree-mods) tests: the `band` and `statusLine` options.
+import { expect, mock, test } from 'claude-code/testing'
+
+const BAND = {
+  plugin: 'cockpit',
+  surface: 'terminal',
+  component: 'AbovePrompt',
+  props: { hasSurvey: false, isWorking: false, maxRows: 10, bodyColumns: 100, scroll: { offset: 0, bodyRows: 10 }, view: {} },
+} as const
+
+test('band off: nothing above the prompt, even with the panel not in front', { options: { band: false } }, async ($, on) => {
+  mock.clock(on, { now: 1_800_000_000_000 })
+  mock.store(on)
+  on('ui.render', ($, e) => {
+    const { Text } = $.ui.resolve(e)
+    return <Text>engine</Text>
+  })
+  const ui = await $.ui.mount(BAND)
+  expect(await ui.find({ type: 'Text', text: /^engine$/ })).toBeDefined()
+  expect(await ui.find({ type: 'Text', text: /Cockpit/ })).toBeUndefined()
+  expect(await ui.find({ type: 'Button', text: /Panel/ })).toBeUndefined()
+  await ui.unmount()
+})
+
+for (const statusLine of [true, false]) {
+  test(`statusLine ${statusLine ? 'left on pins' : 'off never pins'} the ◆ line under the prompt`, { options: { statusLine } }, async ($, on) => {
+    mock.clock(on, { now: 1_800_000_000_000 })
+    mock.store(on)
+    const statuses: (string | undefined)[] = []
+    on('ui.status', (_, e) => {
+      statuses.push(e.text)
+      return { value: undefined }
+    })
+    on('ui.toast', () => ({ value: undefined }))
+    await $.command.run({ command: 'cockpit-demo', args: '' } as Parameters<typeof $.command.run>[0])
+    expect(statuses.filter(Boolean).length > 0).toBe(statusLine)
+  })
+}
