+/// One spelling per file. On Windows, Claude Code reports `C:\x\y`, a Bash
+/// command says `x/y`, `C:/x/y` or Git Bash's `/c/x/y`, and git prints `x/y`;
+/// all become `C:/x/y`, the form git's relative paths can be compared with.
+#[cfg(windows)]
+pub fn canonical_path(path: &str) -> String {
+    let p = path.replace('\\', "/");
+    let b = p.as_bytes();
+    if b.len() >= 2 && b[0] == b'/' && b[1].is_ascii_alphabetic() && b.get(2).is_none_or(|c| *c == b'/') {
+        let rest = if b.len() == 2 { "/" } else { &p[2..] };
+        return format!("{}:{}", (b[1] as char).to_ascii_uppercase(), rest);
+    }
+    if b.len() >= 2 && b[0].is_ascii_alphabetic() && b[1] == b':' {
+        return format!("{}{}", (b[0] as char).to_ascii_uppercase(), &p[1..]);
+    }
+    p
+}
+
