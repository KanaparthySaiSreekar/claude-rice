+/// Copy to the system clipboard with `clip`. It reads UTF-16 when the text
+/// starts with a BOM, and the console's code page otherwise.
+#[cfg(windows)]
+pub fn copy_to_clipboard(text: &str) -> Result<&'static str, String> {
+    let mut child = std::process::Command::new("clip")
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::null())
+        .stderr(std::process::Stdio::null())
+        .spawn()
+        .map_err(|e| format!("cannot start clip: {e}"))?;
+    if let Some(mut stdin) = child.stdin.take() {
+        let bytes: Vec<u8> = std::iter::once('\u{feff}')
+            .chain(text.chars())
+            .collect::<String>()
+            .encode_utf16()
+            .flat_map(u16::to_le_bytes)
+            .collect();
+        stdin
+            .write_all(&bytes)
+            .map_err(|e| format!("write failed: {e}"))?;
+    }
+    match child.wait() {
+        Ok(status) if status.success() => Ok("clip"),
+        _ => Err("clip failed".into()),
+    }
+}
