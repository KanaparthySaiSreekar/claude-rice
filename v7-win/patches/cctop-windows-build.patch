+//! Windows stand-ins for what the Unix build gets from libc and `ps`: process
+//! liveness, this process's CPU time, the UTC offset and the process table.
+
+use std::collections::HashMap;
+use std::mem::{size_of, zeroed};
+
+use windows_sys::Wdk::System::Threading::NtQueryInformationProcess;
+use windows_sys::Win32::Foundation::{
+    CloseHandle, GetLastError, SetHandleInformation, ERROR_ACCESS_DENIED, FILETIME, HANDLE,
+    HANDLE_FLAG_INHERIT, INVALID_HANDLE_VALUE, STILL_ACTIVE, UNICODE_STRING,
+};
+use windows_sys::Win32::System::Console::{
+    GetStdHandle, STD_ERROR_HANDLE, STD_INPUT_HANDLE, STD_OUTPUT_HANDLE,
+};
+use windows_sys::Win32::System::Diagnostics::ToolHelp::{
+    CreateToolhelp32Snapshot, Process32FirstW, Process32NextW, PROCESSENTRY32W, TH32CS_SNAPPROCESS,
+};
+use windows_sys::Win32::System::ProcessStatus::{
+    K32GetProcessMemoryInfo, PROCESS_MEMORY_COUNTERS,
+};
+use windows_sys::Win32::System::SystemInformation::GetSystemTimeAsFileTime;
+use windows_sys::Win32::System::Threading::{
+    GetCurrentProcess, GetExitCodeProcess, GetProcessTimes, OpenProcess,
+    PROCESS_QUERY_LIMITED_INFORMATION,
+};
+use windows_sys::Win32::System::Time::{GetTimeZoneInformation, TIME_ZONE_INFORMATION};
+
+use crate::procs::Proc;
+
+/// `ProcessCommandLineInformation`: readable with limited query rights, so no
+/// reading of another process's memory is needed.
+const PROCESS_COMMAND_LINE_INFORMATION: i32 = 60;
+const TIME_ZONE_ID_STANDARD: u32 = 1;
+const TIME_ZONE_ID_DAYLIGHT: u32 = 2;
+/// FILETIME ticks (100 ns) per second.
+const TICKS: f64 = 10_000_000.0;
+
+/// An open process handle, closed on drop.
+struct Process(HANDLE);
+
+impl Process {
+    fn open(pid: u32) -> Option<Self> {
+        // SAFETY: no memory-safety preconditions; a null result is checked.
+        let h = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, pid) };
+        (h != 0).then_some(Self(h))
+    }
+}
+
+impl Drop for Process {
+    fn drop(&mut self) {
+        // SAFETY: the handle came from OpenProcess and is closed only here.
+        unsafe { CloseHandle(self.0) };
+    }
+}
+
+fn ticks(t: &FILETIME) -> u64 {
+    (u64::from(t.dwHighDateTime) << 32) | u64::from(t.dwLowDateTime)
+}
+
+/// Call before spawning a detached child. A Windows child inherits every
+/// inheritable handle, not only its own stdio, so it would keep this process's
+/// stdout pipe open after this process exits, and a caller reading that pipe
+/// (the pane's `cctop query`) would wait for the child too: issue #15 again.
+/// A later child that asks to inherit stdio still gets it, through a duplicate.
+pub fn keep_std_handles_from_children() {
+    for id in [STD_INPUT_HANDLE, STD_OUTPUT_HANDLE, STD_ERROR_HANDLE] {
+        // SAFETY: only changes a flag on a handle this process owns; both
+        // "no handle" answers are checked.
+        unsafe {
+            let h = GetStdHandle(id);
+            if h != 0 && h != INVALID_HANDLE_VALUE {
+                SetHandleInformation(h, HANDLE_FLAG_INHERIT, 0);
+            }
+        }
+    }
+}
+
+/// True when a process with `pid` exists. Access denied counts as alive, as
+/// `EPERM` does on Unix: the process is there, we just may not query it.
+pub fn pid_alive(pid: u32) -> bool {
+    match Process::open(pid) {
+        Some(p) => {
+            let mut code = 0u32;
+            // SAFETY: `code` is ours and the handle is open.
+            let ok = unsafe { GetExitCodeProcess(p.0, &mut code) };
+            ok != 0 && code == STILL_ACTIVE as u32
+        }
+        // SAFETY: reads this thread's last error, set by OpenProcess above.
+        None => unsafe { GetLastError() == ERROR_ACCESS_DENIED },
+    }
+}
+
+/// `(created, kernel + user)` of a process, in FILETIME ticks.
+fn times(h: HANDLE) -> Option<(u64, u64)> {
+    // SAFETY: an all-zero FILETIME is valid; the call fills the four we own.
+    unsafe {
+        let (mut created, mut exited): (FILETIME, FILETIME) = (zeroed(), zeroed());
+        let (mut kernel, mut user): (FILETIME, FILETIME) = (zeroed(), zeroed());
+        let ok = GetProcessTimes(h, &mut created, &mut exited, &mut kernel, &mut user);
+        (ok != 0).then(|| (ticks(&created), ticks(&kernel) + ticks(&user)))
+    }
+}
+
+/// This process's CPU time so far (user + system), seconds.
+pub fn process_cpu_s() -> f64 {
+    // SAFETY: the pseudo-handle of the current process needs no closing.
+    let me = unsafe { GetCurrentProcess() };
+    times(me).map_or(0.0, |(_, cpu)| cpu as f64 / TICKS)
+}
+
+/// This machine's UTC offset in seconds, east positive.
+pub fn local_offset_secs() -> i64 {
+    // SAFETY: an all-zero struct is valid, and the call fills it.
+    let (zone, tz) = unsafe {
+        let mut tz: TIME_ZONE_INFORMATION = zeroed();
+        (GetTimeZoneInformation(&mut tz), tz)
+    };
+    let bias = i64::from(tz.Bias)
+        + match zone {
+            TIME_ZONE_ID_DAYLIGHT => i64::from(tz.DaylightBias),
+            TIME_ZONE_ID_STANDARD => i64::from(tz.StandardBias),
+            _ => 0,
+        };
+    -bias * 60
+}
+
+/// Every process as `(pid, parent pid, exe name)`, from one snapshot.
+fn snapshot() -> Vec<(u32, u32, String)> {
+    let mut out = Vec::new();
+    // SAFETY: the handle is checked before use and closed below; the entry is
+    // ours, with dwSize set as the API requires.
+    unsafe {
+        let snap = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+        if snap == INVALID_HANDLE_VALUE {
+            return out;
+        }
+        let mut e: PROCESSENTRY32W = zeroed();
+        e.dwSize = size_of::<PROCESSENTRY32W>() as u32;
+        let mut more = Process32FirstW(snap, &mut e) != 0;
+        while more {
+            let len = e.szExeFile.iter().position(|c| *c == 0).unwrap_or(e.szExeFile.len());
+            out.push((
+                e.th32ProcessID,
+                e.th32ParentProcessID,
+                String::from_utf16_lossy(&e.szExeFile[..len]),
+            ));
+            more = Process32NextW(snap, &mut e) != 0;
+        }
+        CloseHandle(snap);
+    }
+    out
+}
+
+/// `pid`'s chain of parents, nearest first. A dead parent's id can be reused,
+/// so the walk is capped rather than trusted to end.
+fn parents_of(all: &[(u32, u32, String)], pid: u32) -> Vec<u32> {
+    let parent: HashMap<u32, u32> = all.iter().map(|(p, pp, _)| (*p, *pp)).collect();
+    let mut out = Vec::new();
+    let mut at = pid;
+    while let Some(&next) = parent.get(&at) {
+        if next == 0 || out.len() >= 32 || out.contains(&next) {
+            break;
+        }
+        out.push(next);
+        at = next;
+    }
+    out
+}
+
+/// This process's chain of parents, nearest first. A server spawned through
+/// a `.cmd` shim has the shim between it and `claude`, so not only the parent.
+pub fn ancestors() -> Vec<u32> {
+    parents_of(&snapshot(), std::process::id())
+}
+
+/// The command line of a process. The buffer starts with a UNICODE_STRING
+/// pointing further into itself.
+fn command_line(h: HANDLE) -> Option<String> {
+    let mut size = 4096u32;
+    for _ in 0..2 {
+        // u64 elements: the UNICODE_STRING at the start needs pointer alignment.
+        let mut buf = vec![0u64; (size as usize).div_ceil(8)];
+        let mut needed = 0u32;
+        // SAFETY: the buffer is ours and `size` bytes long.
+        let status = unsafe {
+            NtQueryInformationProcess(
+                h,
+                PROCESS_COMMAND_LINE_INFORMATION,
+                buf.as_mut_ptr().cast(),
+                size,
+                &mut needed,
+            )
+        };
+        if status >= 0 {
+            // SAFETY: on success the buffer starts with a UNICODE_STRING whose
+            // Buffer holds Length bytes, inside the allocation we still hold.
+            let text = unsafe {
+                let s = &*buf.as_ptr().cast::<UNICODE_STRING>();
+                if s.Buffer.is_null() {
+                    return None;
+                }
+                std::slice::from_raw_parts(s.Buffer, usize::from(s.Length) / 2)
+            };
+            return Some(String::from_utf16_lossy(text));
+        }
+        if needed <= size {
+            return None;
+        }
+        size = needed;
+    }
+    None
+}
+
+/// `"C:\Program Files\Git\bin\bash.exe" -c x` → `bash -c x`: the shape the
+/// rest of `procs` reads, which splits on spaces and looks at the first word.
+pub fn normalize_cmdline(raw: &str) -> String {
+    let raw = raw.trim();
+    let (exe, rest) = match raw.strip_prefix('"') {
+        Some(after) => after.split_once('"').unwrap_or((after, "")),
+        None => raw.split_once(char::is_whitespace).unwrap_or((raw, "")),
+    };
+    let base = exe.rsplit(['\\', '/']).next().unwrap_or(exe);
+    let stem = match base.len().checked_sub(4) {
+        Some(n) if base.is_char_boundary(n) && base[n..].eq_ignore_ascii_case(".exe") => &base[..n],
+        _ => base,
+    };
+    let rest = rest.trim();
+    if rest.is_empty() {
+        stem.to_string()
+    } else {
+        format!("{stem} {rest}")
+    }
+}
+
+/// Every process, the columns `ps -axo pid,ppid,pcpu,rss,etime,command` gives
+/// on Unix. A process this user may not query keeps its exe name and zeros;
+/// the CPU figure is the lifetime average, as Linux's `pcpu` is.
+pub fn process_table() -> Vec<Proc> {
+    let mut now: FILETIME = unsafe { zeroed() };
+    // SAFETY: the call fills the struct we own.
+    unsafe { GetSystemTimeAsFileTime(&mut now) };
+    let now = ticks(&now);
+    snapshot()
+        .into_iter()
+        .filter(|(pid, _, _)| *pid != 0)
+        .map(|(pid, ppid, exe)| {
+            let mut row = Proc {
+                pid,
+                ppid,
+                cpu_pct: 0.0,
+                rss_bytes: 0,
+                elapsed_s: 0,
+                cmdline: normalize_cmdline(&exe),
+            };
+            let Some(p) = Process::open(pid) else {
+                return row;
+            };
+            if let Some((created, cpu)) = times(p.0) {
+                let elapsed = now.saturating_sub(created);
+                row.elapsed_s = (elapsed as f64 / TICKS) as u64;
+                if elapsed > 0 {
+                    row.cpu_pct = (cpu as f64 / elapsed as f64 * 100.0) as f32;
+                }
+            }
+            // SAFETY: an all-zero counters struct is valid, and `cb` is its size.
+            unsafe {
+                let mut mem: PROCESS_MEMORY_COUNTERS = zeroed();
+                mem.cb = size_of::<PROCESS_MEMORY_COUNTERS>() as u32;
+                if K32GetProcessMemoryInfo(p.0, &mut mem, mem.cb) != 0 {
+                    row.rss_bytes = mem.WorkingSetSize as u64;
+                }
+            }
+            if let Some(line) = command_line(p.0).filter(|l| !l.trim().is_empty()) {
+                row.cmdline = normalize_cmdline(&line);
+            }
+            row
+        })
+        .collect()
+}
