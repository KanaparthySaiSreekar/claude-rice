+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn normalize_takes_the_exe_down_to_its_stem() {
+        let n = normalize_cmdline;
+        assert_eq!(n(r#""C:\Program Files\Git\bin\bash.exe" -c "cargo test""#), r#"bash -c "cargo test""#);
+        assert_eq!(n(r"C:\Windows\System32\cmd.exe /c dir"), "cmd /c dir");
+        assert_eq!(n("node.EXE server.js"), "node server.js");
+        assert_eq!(n("bash"), "bash");
+        assert_eq!(n("/usr/bin/git status"), "git status");
+        assert_eq!(n(""), "");
+    }
+
+    #[test]
+    fn this_process_is_alive_and_a_bogus_pid_is_not() {
+        assert!(pid_alive(std::process::id()));
+        assert!(!pid_alive(0xFFFF_FFF0));
+    }
+
+    #[test]
+    fn the_table_finds_this_process_with_real_numbers() {
+        let all = process_table();
+        let me = all.iter().find(|p| p.pid == std::process::id()).expect("own row");
+        assert!(me.rss_bytes > 0, "{me:?}");
+        assert!(me.cmdline.contains("cctop"), "{me:?}");
+        assert!(!me.cmdline.contains(".exe "), "{me:?}");
+    }
+
+    #[test]
+    fn the_parent_walk_stops_at_a_cycle() {
+        let all = vec![(1, 2, String::new()), (2, 1, String::new())];
+        assert_eq!(parents_of(&all, 1), vec![2, 1]);
+        let chain = vec![(5, 4, String::new()), (4, 0, String::new())];
+        assert_eq!(parents_of(&chain, 5), vec![4]);
+    }
+}
