diff --git a/plugins/filetree/tests/surfaces.test.tsx b/plugins/filetree/tests/surfaces.test.tsx
index e1fc76e..cca2624 100644
--- a/plugins/filetree/tests/surfaces.test.tsx
+++ b/plugins/filetree/tests/surfaces.test.tsx
@@ -1369,3 +1369,28 @@ test('files a Grep or Glob search returns shimmer as reads, relative names resol
   expect(await texts(ui)).toContain(shimmer('a.ts', 'purple'))
   await ui.unmount()
 })
+
+// LOCAL PATCH (kasasree-mods) tests: the addColor and removeColor options.
+for (const colors of [undefined, { addColor: '#7DF1D3', removeColor: '#FF6A3D' }] as const) {
+  test(`git colors: ${colors ? 'addColor and removeColor replace the built-in green and red' : 'left unset, the built-in green and red stay'}`, { timeoutMs: 20_000, options: colors ?? {} }, async ($, on) => {
+    const root = '/home/k/proj'
+    const clock = world(on, {
+      os: 'linux', env: { HOME: '/home/k' }, cwd: root, top: root,
+      dirs: { [root]: [['src', 'dir'], ['notes.md', 'file']], [`${root}/src`]: [['a.ts', 'file']] },
+      status: '## main\0 M src/a.ts\0?? notes.md\0 D gone.ts\0', numstat: '3\t1\tsrc/a.ts\0',
+    }, [])
+    await $.session.start({ cwd: root, surface: 'terminal', isInteractive: true })
+    await clock.settle()
+    const ui = await $.ui.mount({ plugin: 'filetree', surface: 'terminal', component: 'Pane', requestId: 'filetree', props: paneProps(60) })
+    await clock.settle()
+    const shown = await texts(ui)
+    const [add, del, urgent] = colors ? [colors.addColor, colors.removeColor, colors.removeColor] : ['#98c379', '#e06c75', '#d0605e']
+    expect(shown).toContain(`" +3","c":"${add}"`)
+    expect(shown).toContain(`" -1","c":"${del}"`)
+    expect(shown).toContain(`{"t":"notes.md","c":"${add}"`)
+    expect(shown).toContain(`{"color":"${add}"},"children":[" ?:1"]`)
+    expect(shown).toContain(`{"color":"${urgent}"},"children":[" D:1"]`)
+    if (colors) for (const old of ['#98c379', '#e06c75', '#d0605e']) expect(shown).not.toContain(old)
+    await ui.unmount()
+  })
+}
