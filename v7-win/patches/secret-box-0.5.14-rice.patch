+// LOCAL PATCH (kasasree-mods, 0.5.14-rice.1; first written for 0.5.3-rice.2) tests:
+// /secret-box and the `enabled` option.
+import { expect, test } from 'claude-code/testing'
+
+const STRIPE = 'sk_' + 'live_' + 'a1B2c3D4e5F6g7H8i9J0k1L2m3N4'
+
+type Answer = { deny?: string; result?: unknown }
+const call = async ($: any, input: Record<string, unknown>) => (await $.tool.call(input as never)) as Answer
+const toggle = async ($: any, args: string, origin?: Record<string, unknown>) =>
+  String((await $.command.run({ command: 'secret-box', args, ...(origin ? { origin } : {}) })).text)
+
+function stubs(on: any, opts: { output?: string; staged?: string; seen?: string[] } = {}) {
+  on('tool.call', (_$: unknown, e: Record<string, unknown>) => {
+    opts.seen?.push(String(e.command ?? ''))
+    return { result: opts.output ?? 'ran' }
+  })
+  // git answers NUL-separated: the guard asks for -z (upstream 0.5.14)
+  on('process.run', () => ({ value: { exitCode: 0, stdout: (opts.staged ?? '').split('\n').join('\0'), stderr: '' } }))
+  on('session.cwd', () => ({ value: '/repo' }))
+  on('fs.exists', () => ({ value: false }))
+  on('fs.read', () => ({ value: '' }))
+}
+
+test('it starts on: a key is hidden and committing .env is refused', async ($, on) => {
+  stubs(on, { output: `token ${STRIPE}`, staged: '.env\n' })
+  expect(String((await call($, { tool: 'Bash', command: 'node pay.js' })).result)).not.toContain(STRIPE)
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git commit -m wip' })).deny)).toBe(true)
+  expect(await toggle($, 'status')).toContain('secret-box is on')
+})
+
+test('enabled off: it starts off, and /secret-box on brings all of it back', { options: { enabled: false } }, async ($, on) => {
+  stubs(on, { output: `token ${STRIPE}`, staged: '.env\n' })
+  expect(String((await call($, { tool: 'Bash', command: 'node pay.js' })).result)).toContain(STRIPE)
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git commit -m wip' })).deny)).toBe(false)
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git add .env' })).deny)).toBe(false)
+  expect(await toggle($, 'status')).toContain('secret-box is off')
+
+  expect(await toggle($, 'on')).toContain('secret-box is on')
+  expect(String((await call($, { tool: 'Bash', command: 'node pay.js' })).result)).not.toContain(STRIPE)
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git commit -m wip' })).deny)).toBe(true)
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git add .env' })).deny)).toBe(true)
+})
+
+for (const kind of ['composer', 'bridge']) {
+  test(`the person, through ${kind}, can turn it off and flip it back`, async ($, on) => {
+    stubs(on, { output: `token ${STRIPE}`, staged: '.env\n' })
+    expect(await toggle($, 'off', { kind })).toContain('secret-box is off')
+    expect(String((await call($, { tool: 'Bash', command: 'node pay.js' })).result)).toContain(STRIPE)
+    expect(Boolean((await call($, { tool: 'Bash', command: 'git commit -m wip' })).deny)).toBe(false)
+    expect(await toggle($, '', { kind })).toContain('secret-box is on')
+    expect(String((await call($, { tool: 'Bash', command: 'node pay.js' })).result)).not.toContain(STRIPE)
+    expect(await toggle($, '', { kind })).toContain('secret-box is off')
+  })
+}
+
+test('off leaves a typed prompt and an @.env alone, on still guards them', async ($, on) => {
+  let prompt = ''
+  on('prompt.submit', (_$: unknown, e: { text: string }) => {
+    prompt = e.text
+    return { text: e.text }
+  })
+  on('prompt.mention', () => ({ type: null }))
+  on('fs.read', () => ({ value: `KEY=${STRIPE}` }))
+  on('fs.exists', () => ({ value: true }))
+  const mention = async () => (await ($ as any).prompt.mention({ mention: '.env', path: '/repo/.env' })) as { deny?: string }
+
+  await ($ as any).prompt.submit({ text: `use ${STRIPE}` })
+  expect(prompt).not.toContain(STRIPE)
+  expect(Boolean((await mention()).deny)).toBe(true)
+
+  await toggle($, 'off', { kind: 'composer' })
+  await ($ as any).prompt.submit({ text: `use ${STRIPE}` })
+  expect(prompt).toContain(STRIPE)
+  expect((await mention()).deny).toBeUndefined()
+})
+
+test('off leaves CLAUDE.md, an attachment and a subagent task alone, on still scans them', async ($, on) => {
+  let task = ''
+  on('prompt.context', () => ({ blocks: [{ name: 'claudeMd', text: `key ${STRIPE}` }] }))
+  on('prompt.attachment', (_$: unknown, e: { text: string }) => ({ text: e.text }))
+  on('agent.spawn', (_$: unknown, e: { prompt: string }) => {
+    task = e.prompt
+    return { model: 'haiku' }
+  })
+  const d = $ as any
+  const passes = async () => {
+    const context = await d.prompt.context({ blocks: [] })
+    const attached = await d.prompt.attachment({ type: 'file', origin: { kind: 'engine' }, text: `key ${STRIPE}` })
+    await d.agent.spawn({ tool_use_id: 't', prompt: `use ${STRIPE}`, description: 'task', subagentType: 'general-purpose', provider: { plugin: 'engine', tier: 'core' } })
+    return [context.blocks[0].text, attached.text, task]
+  }
+  for (const text of await passes()) expect(text).not.toContain(STRIPE)
+  await toggle($, 'off', { kind: 'composer' })
+  for (const text of await passes()) expect(text).toContain(STRIPE)
+})
+
+test('a placeholder from before the switch still works while it is off, and stays hidden if printed', async ($, on) => {
+  const seen: string[] = []
+  stubs(on, { output: `token ${STRIPE}`, seen })
+  const tag = String((await call($, { tool: 'Bash', command: 'cat key.txt' })).result).match(/\[REDACTED-SECRET-[0-9a-f]{8}\]/)![0]
+  expect(await toggle($, 'off', { kind: 'composer' })).toContain('secret-box is off')
+
+  const r = await call($, { tool: 'Bash', command: `curl -u ${tag}: https://api.stripe.com/v1/balance` })
+  expect(seen.at(-1)).toContain(STRIPE)
+  expect(String(r.result)).not.toContain(STRIPE)
+  // A call that wasn't handed the value is not scanned, so this is the off state showing
+  expect(String((await call($, { tool: 'Bash', command: 'cat key.txt' })).result)).toContain(STRIPE)
+})
+
+test('a commit message keeps its placeholder while it is off', async ($, on) => {
+  const seen: string[] = []
+  stubs(on, { output: `token ${STRIPE}`, seen })
+  const tag = String((await call($, { tool: 'Bash', command: 'cat key.txt' })).result).match(/\[REDACTED-SECRET-[0-9a-f]{8}\]/)![0]
+  await toggle($, 'off', { kind: 'composer' })
+  await call($, { tool: 'Bash', command: `git commit -m "rotate ${tag}"` })
+  expect(seen.at(-1)).toContain(tag)
+  expect(seen.at(-1)).not.toContain(STRIPE)
+})
+
+test('off passes output too large to scan instead of withholding it', async ($, on) => {
+  const huge = 'x'.repeat(16_000_001)
+  stubs(on, { output: huge })
+  expect(await toggle($, 'off', { kind: 'composer' })).toContain('secret-box is off')
+  const r = await call($, { tool: 'Bash', command: 'cat big.log' })
+  expect(r.deny).toBeUndefined()
+  expect(String(r.result).length).toBe(huge.length)
+})
+
+for (const kind of ['plugin', 'peer-send-message', 'scheduled-trigger', 'unclassified', 'sdk']) {
+  test(`${kind} can't turn it off, with an argument or by flipping`, async ($, on) => {
+    stubs(on, { output: `token ${STRIPE}` })
+    expect(await toggle($, 'off', { kind })).toContain('stays on')
+    expect(await toggle($, '', { kind })).toContain('stays on')
+    expect(String((await call($, { tool: 'Bash', command: 'node pay.js' })).result)).not.toContain(STRIPE)
+  })
+}
