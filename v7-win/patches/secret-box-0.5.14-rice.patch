+// LOCAL PATCH (kasasree-mods, 0.5.14-rice.1) tests: the commit guard on Windows, and git messages read as text.
+//
+// 0.5.3-rice.1 rewrote upstream's guard; upstream 0.5.14 then rewrote it again (commit-guard.js) and fixed most
+// of the same refusals. These are the rice.1 cases that came from real sessions, now run against upstream's
+// guard as a Windows session sees it (OS=Windows_NT), plus the two things still patched here: USERPROFILE
+// stands in for a missing HOME, and the text of a git message (-m, -F -) is never read as commands.
+import { expect, test } from 'claude-code/testing'
+
+type Answer = { deny?: string; result?: unknown }
+const call = async ($: any, input: Record<string, unknown>) => (await $.tool.call(input as never)) as Answer
+
+// `missing` folders fail as native git fails on them; `repos` lists every folder that is a repository
+// (default: all); `staged` maps a folder to what is staged there; `env` is the environment (default: Windows).
+function repoStub(on: any, opts: { staged?: Record<string, string>; missing?: string[]; repos?: string[]; argvs?: string[][]; env?: Record<string, string> } = {}) {
+  const env = opts.env ?? { OS: 'Windows_NT' }
+  on('tool.call', () => ({ result: 'ran' }))
+  on('env.get', (_$: unknown, e: { name: string }) => ({ value: env[e.name] }))
+  on('process.run', (_$: unknown, e: { argv: string[] }) => {
+    opts.argvs?.push([...e.argv])
+    const c = e.argv.indexOf('-C')
+    const dir = c >= 0 ? e.argv[c + 1] : ''
+    if (opts.missing?.includes(dir)) return { value: { exitCode: 128, stdout: '', stderr: `fatal: cannot change to '${dir}': No such file or directory` } }
+    if (opts.repos && !opts.repos.includes(dir)) return { value: { exitCode: 128, stdout: '', stderr: 'fatal: not a git repository (or any of the parent directories): .git' } }
+    // -z: names NUL-separated
+    return { value: { exitCode: 0, stdout: e.argv.includes('diff') ? (opts.staged?.[dir] ?? '').split('\n').join('\0') : '.git', stderr: '' } }
+  })
+}
+const checked = (argvs: string[][]) => argvs.filter((a) => a.includes('diff')).map((a) => (a[1] === '-C' ? a[2] : ''))
+const ENV = '.e' + 'nv' // the file name, built so this file's own commands never name it
+
+test('R=folder; git -C $R is checked in that folder (real session)', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { staged: { '/work/app': `${ENV}\n` }, argvs })
+  const r = await call($, { tool: 'Bash', command: 'R=/work/app && SP="/tmp/s" && git -C $R commit -q -F "$SP/msg1.txt" && git -C $R log --oneline -1' })
+  expect(String(r.deny)).toContain(ENV)
+  expect(checked(argvs)).toEqual(['/work/app'])
+})
+
+test('a quoted "$R" with nothing staged runs (real session)', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { argvs })
+  const r = await call($, { tool: 'Bash', command: 'R="C:/work/app"; git -C "$R" commit -q -F msg.txt && git -C "$R" log --oneline -5' })
+  expect(r.deny).toBeUndefined()
+  expect(checked(argvs)).toEqual(['C:/work/app'])
+})
+
+test('a Git Bash /c/ path is checked at C:/ (real session)', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { missing: ['/c/work/app'], argvs })
+  const r = await call($, { tool: 'Bash', command: 'git -C /c/work/app commit -q -F msg.txt' })
+  expect(r.deny).toBeUndefined()
+  expect(checked(argvs)).toEqual(['C:/work/app'])
+})
+
+test('a staged .env is still refused through a Git Bash path', async ($, on) => {
+  repoStub(on, { missing: ['/c/work/app'], staged: { 'C:/work/app': `${ENV}\n` } })
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git -C /c/work/app commit -m wip' })).deny)).toBe(true)
+})
+
+test('on Mac and Linux a real /c/ folder is used as it is', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { argvs, env: {} })
+  await call($, { tool: 'Bash', command: 'git -C /c/work commit -m wip' })
+  expect(checked(argvs)).toEqual(['/c/work'])
+})
+
+test('cd then commit, in a Git Bash path, runs (real session)', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { missing: ['/c/work/app'], argvs })
+  const r = await call($, { tool: 'Bash', command: 'cd /c/work/app && git commit -q -F "C:/tmp/msg1.txt" && git log --oneline -1' })
+  expect(r.deny).toBeUndefined()
+  expect(checked(argvs)).toEqual(['C:/work/app'])
+})
+
+test('cd into a repository with a staged .env is refused, whatever the session folder holds', async ($, on) => {
+  repoStub(on, { staged: { '/other': `${ENV}\n`, '': '' }, env: {} })
+  expect(Boolean((await call($, { tool: 'Bash', command: 'cd /other && git commit -m wip' })).deny)).toBe(true)
+})
+
+// Upstream checks every folder a ;-chain of cds could leave the shell in (a cd may fail and the next
+// command still runs), not only the one where they all worked. More checks, never fewer.
+test('relative cd and -C build on each other, and the folder they reach is checked', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { argvs, env: {} })
+  expect((await call($, { tool: 'Bash', command: 'cd /work; cd app; git -C sub commit -m wip' })).deny).toBeUndefined()
+  expect(checked(argvs)).toContain('/work/app/sub')
+})
+
+test('a subshell keeps its cd to itself', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { argvs, env: {} })
+  await call($, { tool: 'Bash', command: '(cd /a && git commit -m one); git commit -m two' })
+  expect(checked(argvs).sort()).toEqual(['', '/a'])
+})
+
+// LOCAL PATCH: Claude Code on native Windows has no HOME
+test('~ and $HOME follow the home folder, and USERPROFILE stands in for it on Windows', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { env: { OS: 'Windows_NT', USERPROFILE: 'C:\\Users\\me' }, argvs })
+  const r = await call($, { tool: 'Bash', command: 'git -C ~/app commit -m a; git -C "$HOME/lib" commit -m b' })
+  expect(r.deny).toBeUndefined()
+  expect(checked(argvs).sort()).toEqual(['C:/Users/me/app', 'C:/Users/me/lib'])
+})
+
+test('a HOME that is set wins over USERPROFILE', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { env: { HOME: '/home/me', USERPROFILE: 'C:/Users/other' }, argvs })
+  await call($, { tool: 'Bash', command: 'git -C ~/app commit -m a' })
+  expect(checked(argvs)).toEqual(['/home/me/app'])
+})
+
+for (const command of ['git -C "$(pick-repo)" commit -m wip', 'git -C "$UNSET" commit -m wip', 'cd - && git commit -m wip']) {
+  test(`only the running command knows the folder, so it is refused with how to retry: ${command}`, async ($, on) => {
+    const argvs: string[][] = []
+    repoStub(on, { argvs })
+    const r = await call($, { tool: 'Bash', command })
+    expect(String(r.deny)).toContain('git -C /path/to/repo')
+    expect(checked(argvs).length).toBe(0)
+  })
+}
+
+// Not patched: a cd between the assignment and the commit would make "the same repository" the wrong one.
+test('the repository root substitution is refused with how to retry, after its own git call is checked', async ($, on) => {
+  repoStub(on, {})
+  const r = await call($, { tool: 'Bash', command: 'R=$(git rev-parse --show-toplevel); git -C "$R" commit -m wip' })
+  expect(String(r.deny)).toContain('git -C /path/to/repo')
+})
+
+test('a folder that does not exist is refused, naming what git said', async ($, on) => {
+  repoStub(on, { missing: ['/nope'], env: {} })
+  const r = await call($, { tool: 'Bash', command: 'git -C /nope commit -m wip' })
+  expect(String(r.deny)).toContain('cannot change to')
+})
+
+// Upstream's choice, kept: the same command may run git init (or a clone) first, and then commit .env.
+test('a commit in a folder that is no repository yet is refused (it may be made one by the same command)', async ($, on) => {
+  repoStub(on, { repos: [] })
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git init && git add -A && git commit -m init' })).deny)).toBe(true)
+})
+
+test('text about commits, from a folder that is no repository, runs', async ($, on) => {
+  repoStub(on, { repos: [] })
+  expect((await call($, { tool: 'Bash', command: 'grep -n "git commit" notes.md' })).deny).toBeUndefined()
+})
+
+test('a commit the guard cannot read still checks the session folder', async ($, on) => {
+  repoStub(on, { staged: { '': `${ENV}\n` } })
+  expect(Boolean((await call($, { tool: 'Bash', command: `bash -c 'git commit -m wip'` })).deny)).toBe(true)
+})
+
+// LOCAL PATCH: a git message is text. Upstream read a quoted string or heredoc that mentions git as code
+// (bash -c '...' is), so a message saying `cd x && git commit` sent the guard to folders that don't exist.
+test('a commit message is text: its words move nothing (heredoc in -m)', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { argvs, missing: ['/other', '/nowhere'] })
+  const message = `git -C /work/app commit -m "$(cat <<'EOF'\ndon't cd /nowhere && git -C /other commit (fix the git path)\nEOF\n)" && git -C /work/app log -1`
+  expect((await call($, { tool: 'Bash', command: message })).deny).toBeUndefined()
+  expect(checked(argvs)).toEqual(['/work/app'])
+})
+
+test('a word in a plain -m message is not a repository either', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { repos: ['/work/app'], argvs })
+  expect((await call($, { tool: 'Bash', command: 'git -C /work/app commit -m "fix the git hook; cd /x && git commit"' })).deny).toBeUndefined()
+  expect(checked(argvs)).toEqual(['/work/app'])
+})
+
+test('git commit -F - reads its message from the heredoc: text, not commands', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { argvs, missing: ['other'] })
+  const r = await call($, { tool: 'Bash', command: `git commit -F - <<'EOF'\nsecret-box: cd other && git add ${ENV} is refused now\nEOF` })
+  expect(r.deny).toBeUndefined()
+  expect(checked(argvs)).toEqual([''])
+})
+
+test('a message that names git add .env does not stage it', async ($, on) => {
+  repoStub(on, {})
+  expect((await call($, { tool: 'Bash', command: `git commit -am "refuse git add ${ENV} in the guard"` })).deny).toBeUndefined()
+  expect((await call($, { tool: 'Bash', command: `git commit -m'git add ${ENV}'` })).deny).toBeUndefined()
+})
+
+test('a real git add .env beside a message is still refused', async ($, on) => {
+  repoStub(on, {})
+  const r = await call($, { tool: 'Bash', command: `git add ${ENV} && git commit -m "add config"` })
+  expect(String(r.deny)).toContain('staging a .env file is blocked')
+})
+
+test('what runs inside a message still counts: its $( ) and a bash -c there', async ($, on) => {
+  const argvs: string[][] = []
+  repoStub(on, { argvs, staged: { '/x': `${ENV}\n` }, env: {} })
+  expect(Boolean((await call($, { tool: 'Bash', command: 'git commit -m "v$(cd /x && git commit -m inner)"' })).deny)).toBe(true)
+  expect(checked(argvs)).toContain('/x')
+  expect(Boolean((await call($, { tool: 'Bash', command: `git commit -m "$(bash -c 'git add ${ENV}')"` })).deny)).toBe(true)
+})
+
+test('a heredoc a shell runs is still read as commands', async ($, on) => {
+  repoStub(on, { staged: { '/x': `${ENV}\n` }, env: {} })
+  expect(Boolean((await call($, { tool: 'Bash', command: `bash <<'EOF'\ncd /x && git commit -m wip\nEOF` })).deny)).toBe(true)
+})
