@@ -0,0 +1,49 @@
+// LOCAL PATCH (kasasree-mods): the glow palette, the band height option, and glyphs the terminal font has.
+import { describe, expect, mock, test } from 'claude-code/testing'
+import { UPSTREAM, glowAt, parseBreathPalette } from '../hooks/breath/glow.ts'
+import { STYLES, frame } from '../hooks/breath/shapes.ts'
+
+const EMBER = { glow: ['#B85A1E', '#FF7A1A', '#FFC53D', '#FFE3A3'], accent: '#FF7A1A', label: '#BFB5AA' }
+// Code points JetBrainsMono Nerd Font Mono has, of those the shapes can draw (read from its cmap, 2026-10-17).
+const IN_FONT = new Set([...' ▁▂▃▄▅▆▇█━─╌┈░▒▓◆•·'].map(c => c.codePointAt(0)!))
+
+describe('rice patch', () => {
+  test('the palette option takes a glow ramp of #RRGGBB stops; anything else keeps upstream\'s single orange', () => {
+    expect(parseBreathPalette('')).toEqual(UPSTREAM)
+    expect(parseBreathPalette('{"glow":["#ff0000"]}').glow).toEqual(UPSTREAM.glow)
+    expect(parseBreathPalette(JSON.stringify(EMBER))).toEqual(EMBER)
+  })
+
+  test('the glow follows the breath: the first stop with empty lungs, the last at the top of the inhale', () => {
+    const p = parseBreathPalette(JSON.stringify(EMBER))
+    expect(glowAt(p, 0)).toBe('#b85a1e')
+    expect(glowAt(p, 1000)).toBe('#ffe3a3')
+    expect(glowAt(p, 500)).not.toBe(glowAt(p, 0))
+    expect(glowAt(UPSTREAM, 300)).toBe('#f7835d')
+  })
+
+  test('every glyph any style draws, at any point of the breath, is in the terminal font', () => {
+    const missing = new Set<string>()
+    for (const style of STYLES) for (let progress = 0; progress <= 1000; progress += 50)
+      for (const line of frame(style, progress, 100)) for (const ch of line) if (!IN_FONT.has(ch.codePointAt(0)!)) missing.add(ch)
+    expect([...missing]).toEqual([])
+  })
+
+  for (const [rows, expected] of [['5', 5], ['1', 3], ['40', 9], ['', 9]] as const) {
+    test(`rows "${rows}" asks for a ${expected}-row band, and the band gets the palette`, { options: { rows, palette: JSON.stringify(EMBER) } }, async ($, on) => {
+      mock.clock(on, { now: 1_000_000 })
+      on('session.start', (_$: any, e: any) => ({ sessionId: 's', cwd: e.cwd }))
+      on('store.get', () => ({ value: undefined }))
+      on('command.register', () => ({ value: undefined }))
+      on('ui.render', ($: any, e: any) => $.ui.resolve(e).Text({ children: 'prompt' }))
+      await $.session.start({ surface: 'terminal', isInteractive: true, cwd: '/work' } as any)
+      const ui = await $.ui.mount({ plugin: 'mindful-breath', surface: 'terminal', component: 'AbovePrompt', props: { hasSurvey: false, isWorking: true, maxRows: 20, bodyColumns: 100 }, viewport: { columns: 100, rows: 40 } } as any)
+      const client = JSON.parse(JSON.stringify(await ui.drawn()), (_k, v) => v)
+      const find = (n: any): any => (n && typeof n === 'object' ? (n.type === 'Client' ? n : [n.children, n.props?.children].flat().map(find).find(Boolean)) : undefined)
+      const c = find(client)
+      expect(c?.props.height).toBe(expected)
+      expect(c?.props.props.palette).toBe(JSON.stringify(EMBER))
+      await ui.unmount()
+    })
+  }
+})
