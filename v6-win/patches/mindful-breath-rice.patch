@@ -0,0 +1,32 @@
+// LOCAL PATCH (kasasree-mods): the band's colours. Upstream draws everything in one Claude orange. With the `palette`
+// option the picture's colour follows the breath along a glow ramp, dim ember with empty lungs to bright at the top of the
+// inhale, so the ember breathes with you; the phase line takes the accent and the exercise name the label colour.
+// Pure: `claude plugin test` covers it.
+
+export type BreathPalette = { glow: string[]; accent: string; label: string | null }
+
+export const UPSTREAM: BreathPalette = { glow: ['#f7835d', '#f7835d'], accent: '#f7835d', label: null }
+
+const HEX = /^#[0-9a-f]{6}$/i
+
+/** The palette a `palette` option names (a JSON object), upstream's single orange for anything missing or malformed. */
+export function parseBreathPalette(option: unknown): BreathPalette {
+  let raw: Record<string, unknown> = {}
+  try {
+    const parsed = typeof option === 'string' && option.trim() ? JSON.parse(option) : {}
+    if (parsed && typeof parsed === 'object') raw = parsed as Record<string, unknown>
+  } catch {}
+  const hex = (v: unknown) => (typeof v === 'string' && HEX.test(v) ? v : null)
+  const glow = Array.isArray(raw.glow) && raw.glow.length >= 2 && raw.glow.every(c => hex(c)) ? (raw.glow as string[]) : UPSTREAM.glow
+  return { glow, accent: hex(raw.accent) ?? UPSTREAM.accent, label: hex(raw.label) }
+}
+
+/** The glow colour at a breath's progress (0 = empty, 1000 = full). */
+export function glowAt(p: BreathPalette, progress: number): string {
+  const ramp = p.glow
+  const x = (Math.min(Math.max(progress, 0), 1000) / 1000) * (ramp.length - 1)
+  const i = Math.min(Math.floor(x), ramp.length - 2)
+  const f = x - i
+  const [a, b] = [ramp[i]!, ramp[i + 1]!].map(h => [1, 3, 5].map(k => parseInt(h.slice(k, k + 2), 16)))
+  return `#${a!.map((v, k) => Math.round(v + (b![k]! - v) * f).toString(16).padStart(2, '0')).join('')}`
+}
