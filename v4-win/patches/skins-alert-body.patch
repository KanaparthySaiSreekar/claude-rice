+  stubEngine(on)
+
+  const text = 'Run `npm test` now.\n\n> [!NOTE]\n> Run `npm test` first.'
+  const ui = await $.ui.mount({ ...SITE, surface: 'terminal', component: 'AssistantMessage', requestId: 'alert-code', props: { text, isFirstOfReply: true } })
