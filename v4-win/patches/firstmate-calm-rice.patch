index 0000000..5993e64
--- /dev/null
+++ b/plugins/firstmate-calm/tests/rice.test.ts
@@ -0,0 +1,66 @@
+// The rice fork's own behaviour: active without the pre-launch env opt-in, the toggle kept in the mod's store,
+// no file system, and only glyphs the terminal font has.
+import { describe, expect, test } from "claude-code/testing";
+import { CALM_WORKING_SHIP_HULL, CALM_WORKING_SHIP_SAIL, CALM_WORKING_SHIP_WAVE_BARS } from "../lib/fm-calm-working-ship-sprite.ts";
+import { CALM_SHIP_RICE_PALETTE, hexOf, parseCalmShipPalette } from "../lib/fm-calm-ship-raster.ts";
+import { assistantMessage, calmCommand, isHidden, isStock, spinner, toolGroup, toolResult, toolUse, userMessage, world } from "./support.ts";
+
+const sessionStart = { cwd: "/work", surface: "terminal" as const, isInteractive: true };
+
+// Code points JetBrainsMono Nerd Font Mono has (read from its cmap with WPF's GlyphTypeface, 2026-10-17).
+// Upstream's sail glyphs U+25FF and U+25E3 are NOT in it, which is why the fork changed them.
+const IN_FONT = new Set([0x20, 0x2502, 0x2571, 0x2572, 0x2581, 0x2582, 0x2583, 0x2584, 0xe0b8, 0xe0ba]);
+
+describe("rice fork", () => {
+  test("is active with no CLAUDE_CODE_ENABLE_FUNCTION_HOOKS at all: registers /calm and hides tool rows from the start", async ($, on) => {
+    const { journal } = world(on, { functionHooks: undefined, home: undefined });
+    await $.session.start(sessionStart);
+    expect(journal.commands).toEqual(["calm"]);
+    for (const drawing of [await $.ui.render(toolUse()), await $.ui.render(toolResult()), await $.ui.render(toolGroup())]) {
+      expect(isHidden(drawing)).toBe(true);
+    }
+    expect(isStock(await $.ui.render(userMessage("hello there")))).toBe(true);
+    expect(isStock(await $.ui.render(assistantMessage("Here is the answer.")))).toBe(true);
+  });
+
+  test("start: off leaves every drawing to the engine until /calm", { options: { start: "off" } }, async ($, on) => {
+    world(on);
+    await $.session.start(sessionStart);
+    expect(isStock(await $.ui.render(toolUse()))).toBe(true);
+    expect(isStock(await $.ui.render(spinner()))).toBe(true);
+    await $.command.run(calmCommand());
+    expect(isHidden(await $.ui.render(toolUse()))).toBe(true);
+  });
+
+  test("/calm toggles, toasts, redraws, keeps the choice in the store across a new session, and touches no file", async ($, on) => {
+    const { journal } = world(on);
+    await $.session.start(sessionStart);
+    const redraws = journal.invalidations.length;
+    expect(await $.command.run(calmCommand())).toEqual({});
+    expect(journal.toasts.at(-1)).toMatch(/^Calm off/);
+    expect(journal.invalidations.length).toBeGreaterThan(redraws);
+    expect(isStock(await $.ui.render(toolUse()))).toBe(true);
+    await $.session.start(sessionStart);
+    expect(isStock(await $.ui.render(toolUse())), "off survives a new session").toBe(true);
+    await $.command.run(calmCommand());
+    expect(journal.toasts.at(-1)).toMatch(/^Calm on/);
+    await $.session.start(sessionStart);
+    expect(isHidden(await $.ui.render(toolUse())), "on survives a new session").toBe(true);
+    expect(journal.fsReads).toEqual([]);
+  });
+
+  test("every glyph the boat and the swell can draw is in the terminal font", () => {
+    const glyphs = [...CALM_WORKING_SHIP_SAIL, ...CALM_WORKING_SHIP_HULL, ...CALM_WORKING_SHIP_WAVE_BARS.join("")].map((g) => g.codePointAt(0)!);
+    expect(glyphs.filter((cp) => !IN_FONT.has(cp)).map((cp) => cp.toString(16))).toEqual([]);
+  });
+
+  test("the palette option reads #RRGGBB per key, keeps Ember for anything missing or malformed", () => {
+    expect(parseCalmShipPalette("")).toEqual(CALM_SHIP_RICE_PALETTE);
+    expect(parseCalmShipPalette("not json")).toEqual(CALM_SHIP_RICE_PALETTE);
+    expect(parseCalmShipPalette('{"boat":"red"}')).toEqual(CALM_SHIP_RICE_PALETTE);
+    const p = parseCalmShipPalette('{"boat":"#FF4040","water":"#b33030"}');
+    expect(hexOf(p.boat)).toBe("#ff4040");
+    expect(hexOf(p.water)).toBe("#b33030");
+    expect(p.sail).toBe(CALM_SHIP_RICE_PALETTE.sail);
+  });
+});
