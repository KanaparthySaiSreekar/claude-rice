-export function replayOutcomeNotes(
-  rows: readonly OutcomeRow[],
-  cursor: number,
-  processed: number,
-  shownThrough = 0,
-): string[] {
-  const shown = shownThrough > (rows[rows.length - 1]?.seq ?? 0) ? 0 : shownThrough;
