+type Node = { type?: string; props?: Record<string, unknown>; children?: unknown[]; part?: unknown }
+export type ContextLine = { column: Node; at: number; band: Node; line: Node; width: number }
+export function findContextLine(rest: unknown): ContextLine | null {
