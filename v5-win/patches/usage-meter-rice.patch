+// LOCAL PATCH (kasasree-mods): colours from the `palette` option (the rice writes it from its palette file). With a ramp,
+// each bar cell takes the ramp colour of its place, so a nearly empty bar is pale and a full one hot (as the v2 status line
+// draws its gauges), and the percentage stays plain until 75%. Upstream: named green, yellow and red, and dim grey text.
+// `join: on` puts this row beside context-bar's one-row `line` style when both fit.
+export type Colors = { ramp: string[] | null; ok: string; warn: string; err: string; label: string | null; fg: string | null }
+export const UPSTREAM_COLORS: Colors = { ramp: null, ok: 'green', warn: 'yellow', err: 'red', label: null, fg: null }
+const HEX = /^#[0-9a-f]{6}$/i
+let colors: Colors = UPSTREAM_COLORS
+let join = false
+
+export function parseColors(option: unknown): Colors {
+  let raw: Record<string, unknown> = {}
+  try {
+    const parsed = typeof option === 'string' && option.trim() ? JSON.parse(option) : {}
+    if (parsed && typeof parsed === 'object') raw = parsed as Record<string, unknown>
+  } catch {}
+  const hex = (v: unknown) => (typeof v === 'string' && HEX.test(v) ? v : null)
+  const ramp = Array.isArray(raw.ramp) && raw.ramp.length >= 2 && raw.ramp.every(c => hex(c)) ? (raw.ramp as string[]) : null
+  return { ramp, ok: hex(raw.ok) ?? 'green', warn: hex(raw.warn) ?? 'yellow', err: hex(raw.err) ?? 'red', label: hex(raw.label), fg: hex(raw.fg) }
+}
+
+/** The colour at `t` (0 to 1) along a ramp of #rrggbb stops. */
+export function rampAt(ramp: string[], t: number) {
+  const x = Math.min(Math.max(t, 0), 1) * (ramp.length - 1)
+  const i = Math.min(Math.floor(x), ramp.length - 2)
+  const f = x - i
+  const [a, b] = [ramp[i]!, ramp[i + 1]!].map(h => [1, 3, 5].map(k => parseInt(h.slice(k, k + 2), 16)))
+  return `#${a!.map((v, k) => Math.round(v + (b![k]! - v) * f).toString(16).padStart(2, '0')).join('')}`
+}
