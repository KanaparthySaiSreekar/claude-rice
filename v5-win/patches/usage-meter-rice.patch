index 0000000..9e5e8b9
--- /dev/null
+++ b/plugins/usage-meter/tests/rice.test.ts
@@ -0,0 +1,87 @@
+// LOCAL PATCH (kasasree-mods): the palette option (ramp-graded bars), and sharing a row with context-bar.
+import { describe, expect, mock, test } from 'claude-code/testing'
+
+import { UPSTREAM_COLORS, findContextLine, joinContextLine, parseColors, rampAt, resetBandOrder } from '../hooks/register'
+
+const NOW = Date.parse('2026-10-03T12:00:00Z')
+const PALETTE = { ramp: ['#FFE3A3', '#FFC53D', '#FF7A1A', '#F0451E'], ok: '#8ED69B', warn: '#FFC53D', err: '#FF4D4D', label: '#BFB5AA', fg: '#F8F4EE' }
+const band = { component: 'AbovePrompt', props: { hasSurvey: false, isWorking: false, maxRows: 10, bodyColumns: 120 } }
+
+function engine(on: any, percent: number, beneath?: unknown) {
+  resetBandOrder()
+  mock.clock(on, { now: NOW })
+  on('env.get', () => ({ value: undefined }))
+  on('session.start', (_$: any, e: any) => ({ sessionId: 's', cwd: e.cwd }))
+  on('session.usage', () => ({ value: { startedAt: NOW, context: { window: 200_000 }, rateLimits: [{ kind: 'five_hour', percentUsed: percent }], cost: { usd: 0.42 } } }))
+  on('ui.toast', () => ({ value: undefined }))
+  on('ui.render', ($: any, e: any) => beneath ?? $.ui.resolve(e).Text({ children: 'engine band' }))
+}
+
+const ctx = (width: number) => ({ type: 'Box', props: { key: 'bands', flexDirection: 'column' }, children: [
+  { type: 'Text', props: {}, children: ['other band'] },
+  { type: 'Box', props: { key: 'band:context-bar', flexDirection: 'column' }, children: [{ type: 'Box', props: { key: 'line', width }, children: [] }] },
+] })
+const mine = { type: 'Box', props: { key: 'mine' }, children: [] }
+
+
+describe('rice patch', () => {
+  test('the palette option reads a ramp of at least two #RRGGBB stops and keeps upstream colors otherwise', () => {
+    expect(parseColors('')).toEqual(UPSTREAM_COLORS)
+    expect(parseColors('{"ramp":["#FFE3A3"]}').ramp).toBeNull()
+    expect(parseColors(JSON.stringify(PALETTE)).ramp).toEqual(PALETTE.ramp)
+    expect(rampAt(['#000000', '#ffffff'], 0)).toBe('#000000')
+    expect(rampAt(['#000000', '#ffffff'], 1)).toBe('#ffffff')
+    expect(rampAt(['#000000', '#ffffff'], 0.5)).toBe('#808080')
+  })
+
+  for (const [percent, expected] of [[40, PALETTE.fg], [80, PALETTE.warn], [95, PALETTE.err]] as const) {
+    test(`with a palette, bar cells follow the ramp and ${percent}% is drawn in ${expected}`, { options: { palette: JSON.stringify(PALETTE) } }, async ($, on) => {
+      engine(on, percent)
+      await $.session.start({ surface: 'terminal', isInteractive: true, cwd: '/work' } as any)
+      const ui = await $.ui.mount({ plugin: 'usage-meter', surface: 'terminal', ...band } as any)
+      const texts: any[] = await ui.findAll({ type: 'Text' })
+      expect(texts[0].text).toBe('◔ ')
+      const cells = texts.filter(t => /^[▁▂▃▄▅▆▇█]$/.test(t.text))
+      expect(cells).toHaveLength(5)
+      expect(cells[0].props.color.toLowerCase()).toBe(rampAt(PALETTE.ramp, 0.1))
+      expect(cells[4].props.color.toLowerCase()).toBe(rampAt(PALETTE.ramp, 0.9))
+      expect(texts.find(t => t.text === ` ${percent}%`)?.props.color).toBe(expected)
+      expect(texts.find(t => t.text === '5h ')?.props.color).toBe(PALETTE.label)
+      await ui.unmount()
+    })
+  }
+
+  test('finds context-bar\'s line, joins beside it, keeps every other band; no line or the box style means no join', () => {
+    const found = findContextLine(ctx(50))!
+    expect(found.width).toBe(50)
+    const joined: any = joinContextLine(ctx(50), found, mine, '#bfb5aa')
+    expect(joined.children).toHaveLength(2)
+    expect(joined.children[0].children).toEqual(['other band'])
+    const row = joined.children[1]
+    expect(row.props.flexDirection).toBe('row')
+    expect(row.children[0].props.key).toBe('line')
+    expect(row.children[1].children).toEqual(['│'])
+    expect(row.children[2]).toBe(mine)
+    expect(findContextLine({ type: 'Text', props: {}, children: ['x'] })).toBeNull()
+    const boxStyle = ctx(50); (boxStyle.children[1] as any).children[0].props = { key: 'x', borderStyle: 'round' }
+    expect(findContextLine(boxStyle)).toBeNull()                            // the bordered box style never joins
+  })
+
+  for (const [columns, together] of [[120, true], [70, true], [60, false]] as const) {
+    test(`in a ${columns}-column band beside a 50-cell context line, the meter ${together ? 'shares its row' : 'takes its own row'}`, { options: { join: 'on', palette: JSON.stringify(PALETTE) } }, async ($, on) => {
+      engine(on, 40, ctx(50))
+      await $.session.start({ surface: 'terminal', isInteractive: true, cwd: '/work' } as any)
+      const ui = await $.ui.mount({ plugin: 'usage-meter', surface: 'terminal', component: 'AbovePrompt', props: { ...band.props, bodyColumns: columns } } as any)
+      const root: any = await ui.drawn()
+      const keys = (root.children as any[]).map(c => c.props?.key ?? 'text')
+      if (together) {
+        expect(keys).toEqual(['text', 'band:context-bar'])
+        expect((root.children[1] as any).props.flexDirection).toBe('row')
+      } else {
+        expect(keys).toContain('band:usage-meter')
+        expect(keys).toContain('band:context-bar')
+      }
+      await ui.unmount()
+    })
+  }
+})
