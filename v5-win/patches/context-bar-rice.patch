diff --git a/plugins/context-bar/tests/rice.test.tsx b/plugins/context-bar/tests/rice.test.tsx
new file mode 100644
index 0000000..49cbfc5
--- /dev/null
+++ b/plugins/context-bar/tests/rice.test.tsx
@@ -0,0 +1,69 @@
+// LOCAL PATCH (kasasree-mods): the palette option and the one-row line style.
+import { describe, expect, test } from 'claude-code/testing'
+
+import { UPSTREAM_COLORS, cells, lineParts, parseColors, resetBandOrder, toReading } from '../hooks/register'
+
+const EMBER = { used: ['#ffcba4', '#ffc53d', '#ff8f70', '#ffa55c', '#e8553c', '#ffe08a'], messages: '#ff7a1a', free: '#3b352f', buffer: '#80776d', ok: '#8ed69b', warn: '#ffc53d', err: '#ff4d4d', label: '#bfb5aa', accent: '#ff7a1a', fg: '#f8f4ee' }
+const BREAKDOWN = {
+  categories: [
+    { name: 'System prompt', tokens: 3_400, color: 'promptBorder', kind: 'used', isDeferred: false },
+    { name: 'System tools', tokens: 12_000, color: 'inactive', kind: 'used', isDeferred: false },
+    { name: 'Messages', tokens: 186_000, color: 'purple_FOR_SUBAGENTS_ONLY', kind: 'used', isDeferred: false },
+    { name: 'Autocompact buffer', tokens: 50_000, color: 'inactive', kind: 'buffer', isDeferred: false },
+    { name: 'Free space', tokens: 748_600, color: 'promptBorder', kind: 'free', isDeferred: false },
+  ],
+  totalTokens: 201_400, maxTokens: 1_000_000, rawMaxTokens: 1_000_000, percentage: 20, autoCompactThreshold: 950_000, isAutoCompactEnabled: true,
+  gridRows: [], memoryFiles: [], mcpTools: [], agents: [], model: 'opus', apiUsage: null, autocompactSource: 'model-default',
+}
+const BAND = { component: 'AbovePrompt', props: { hasSurvey: false, isWorking: false, maxRows: 20, bodyColumns: 120 } }
+
+function engine(on: any) {
+  resetBandOrder()
+  on('env.get', () => ({ value: undefined }))
+  on('session.start', (_$: any, e: any) => ({ sessionId: 's', cwd: e.cwd }))
+  on('command.register', () => ({ value: undefined }))
+  on('store.get', () => ({ value: undefined }))
+  on('session.usage', () => ({ value: { startedAt: 0, context: { tokens: 201_400, window: 1_000_000, percent: 20, breakdown: BREAKDOWN }, rateLimits: {}, cost: { usd: 0 } } }))
+  on('ui.render', ($: any, e: any) => $.ui.resolve(e).Text({ children: 'band below' }))
+}
+const settle = () => new Promise(done => (globalThis as any).setTimeout(done, 20))
+
+describe('rice patch', () => {
+  test('the palette option takes #RRGGBB values and keeps upstream colors for anything missing or malformed', () => {
+    expect(parseColors('')).toEqual(UPSTREAM_COLORS)
+    expect(parseColors('not json')).toEqual(UPSTREAM_COLORS)
+    const c = parseColors(JSON.stringify({ ...EMBER, warn: 'yellow', used: ['#ffcba4', 'blue'] }))
+    expect(c.accent).toBe('#ff7a1a')
+    expect(c.warn).toBe(UPSTREAM_COLORS.warn)
+    expect(c.used).toEqual(UPSTREAM_COLORS.used)
+  })
+
+  test('line style: one row, no border, palette colors, a width usage-meter can join on', { options: { style: 'line', palette: JSON.stringify(EMBER) } }, async ($, on) => {
+    engine(on)
+    await $.session.start({ surface: 'terminal', isInteractive: true, cwd: '/work' } as any)
+    await settle()
+    const ui = await $.ui.mount({ plugin: 'context-bar', surface: 'terminal', ...BAND } as any)
+    expect((await ui.find({ type: 'Text', text: /^◆ $/ }))?.props.color).toBe(EMBER.accent)
+    expect((await ui.find({ type: 'Text', text: /^context $/ }))?.props.color).toBe(EMBER.label)
+    expect((await ui.find({ type: 'Text', text: /^ 20%$/ }))?.props.color).toBe(EMBER.fg)
+    expect(await ui.find({ type: 'Text', text: /messages 186k/ })).toBeDefined()
+    const root: any = await ui.drawn()
+    const band = (root.children as any[]).find(k => k.props?.key === 'band:context-bar')
+    const line = band.children[0]
+    expect(line.props.key).toBe('line')
+    expect(line.props.borderStyle).toBeUndefined()
+    expect(typeof line.props.width).toBe('number')
+    expect(JSON.stringify(root)).not.toContain('#7aa2f7') // no Tokyo Night blue left
+    await ui.unmount()
+  })
+
+  test('the line never outgrows its room: extras go first, the bar keeps at least 10 cells', () => {
+    const r = toReading(BREAKDOWN as any)
+    for (const room of [30, 50, 80, 160]) {
+      const { width, parts } = lineParts(r, room, 0.2)
+      expect(width <= Math.max(room, 10 + 14)).toBe(true)
+      expect(parts.filter(p => /^[█─░]+$/.test(p.text)).reduce((n, p) => n + p.text.length, 0) >= 10).toBe(true)
+    }
+    expect(cells(r, 10).reduce((n, c) => n + c.text.length, 0)).toBe(10)
+  })
+})
