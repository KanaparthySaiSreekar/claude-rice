diff --git a/plugins/prismantis/tests/kasasree.test.tsx b/plugins/prismantis/tests/kasasree.test.tsx
index eaf2566..345c411 100644
--- a/plugins/prismantis/tests/kasasree.test.tsx
+++ b/plugins/prismantis/tests/kasasree.test.tsx
@@ -161,3 +161,78 @@ for (const diffTintOption of [undefined, 'color'] as const) {
     await ui.unmount()
   })
 }
+
+// LOCAL PATCH (kasasree-mods) tests: promptColor and declined 'quiet'.
+const prompt = (text: string, surface: 'terminal' | 'desktop' = 'terminal') =>
+  ({ plugin: 'prismantis', component: 'UserMessage' as const, props: { text, origin: { kind: 'composer' } as never, isExpanded: true }, viewport: { columns: 80, rows: 10 }, surface })
+
+const WHITE = '#F8F4EE'
+
+test('promptColor: the bubble and the text you typed both take the one color, on both surfaces', { options: { theme: 'ember', promptStyle: 'bubble', promptColor: WHITE } }, async $ => {
+  for (const surface of ['terminal', 'desktop'] as const) {
+    const ui = await $.ui.mount(prompt('fix the failing test', surface))
+    const bubble = (await ui.findAll({ type: 'Box' })).find(b => b.props.borderStyle === 'round')
+    expect(bubble?.props.borderColor).toBe(WHITE)
+    expect((await ui.find({ type: 'Text', text: /^fix the failing test$/ }))?.props.color).toBe(WHITE)
+    await ui.unmount()
+  }
+})
+
+test('promptColor: the bar takes it too, and left empty the theme colors stay', { options: { theme: 'ember', promptStyle: 'bar', promptColor: WHITE } }, async $ => {
+  const ui = await $.ui.mount(prompt('hi'))
+  expect((await ui.find({ type: 'Text', text: /^▌ $/ }))?.props.color).toBe(WHITE)
+  await ui.unmount()
+  for (const promptColor of ['', 'not a color']) {
+    const s = resolveStyle({ theme: 'ember', promptColor })
+    expect(s.promptColor).toBeUndefined()
+  }
+})
+
+const CLARIFY = `Error: The user doesn't want to proceed with this tool use. The tool use was rejected (eg. if it was a file edit, the new_string was NOT written to the file). To tell you how to proceed, the user said:
+The user wants to clarify these questions.
+    This means they may have additional information, context or questions for you.
+    Questions asked:
+- "How should your own messages look in the chat?"
+  (No answer provided)`
+const NO_WITH_WORDS = `The user doesn't want to proceed with this tool use. The tool use was rejected (eg. if it was a file edit, the new_string was NOT written to the file). To tell you how to proceed, the user said:
+use tabs, not spaces`
+const NO = `The user doesn't want to proceed with this tool use. The tool use was rejected (eg. if it was a file edit, the new_string was NOT written to the file). STOP what you are doing and wait for the user to tell you how to proceed.`
+const erroredUse = (tool: string, input: unknown, id: string, output: unknown) => ({ ...use(tool, input, id), props: { ...call(tool, input, id), isErrored: true, output } })
+
+test('declined quiet: Chat about this is "chose to chat", dim, with nothing under it', { options: { toolOutput: 'rows', declined: 'quiet' } }, async ($, on) => {
+  engine(on)
+  const row = await $.ui.mount(erroredUse('AskUserQuestion', { questions: [] }, 'd-1', CLARIFY))
+  expect(await row.find({ type: 'Text', text: /chose to chat/ })).toBeDefined()
+  expect(await row.find({ type: 'Text', text: /failed/ })).toBeUndefined()
+  await row.unmount()
+  const out = await $.ui.mount(result('AskUserQuestion', 'd-1', CLARIFY, true))
+  expect(await out.find({ type: 'Text', text: /doesn't want|clarify|engine/ })).toBeUndefined()
+  await out.unmount()
+})
+
+test('declined quiet: a No keeps only the words you typed; a No without words shows none; a real failure still fails', { options: { toolOutput: 'rows', declined: 'quiet' } }, async ($, on) => {
+  engine(on)
+  const row = await $.ui.mount(erroredUse('Edit', { file_path: 'src/a.ts' }, 'd-2', NO_WITH_WORDS))
+  expect(await row.find({ type: 'Text', text: /declined/ })).toBeDefined()
+  await row.unmount()
+  const words = await $.ui.mount(result('Edit', 'd-2', NO_WITH_WORDS, true))
+  expect(await words.find({ type: 'Text', text: /^use tabs, not spaces$/ })).toBeDefined()
+  expect(await words.find({ type: 'Text', text: /doesn't want/ })).toBeUndefined()
+  await words.unmount()
+  const silent = await $.ui.mount(result('Bash', 'd-3', NO, true))
+  expect(await silent.find({ type: 'Text', text: /doesn't want|STOP|engine/ })).toBeUndefined()
+  await silent.unmount()
+  const failed = await $.ui.mount(erroredUse('Bash', { command: 'make test' }, 'd-4', 'Error: Exit code 1\nboom'))
+  expect(await failed.find({ type: 'Text', text: /failed/ })).toBeDefined()
+  await failed.unmount()
+})
+
+test('declined left at failed keeps upstream: Chat about this is a failed row with the message under it', { options: { toolOutput: 'rows' } }, async ($, on) => {
+  engine(on)
+  const row = await $.ui.mount(erroredUse('AskUserQuestion', { questions: [] }, 'd-5', CLARIFY))
+  expect(await row.find({ type: 'Text', text: /failed/ })).toBeDefined()
+  await row.unmount()
+  const out = await $.ui.mount(result('AskUserQuestion', 'd-5', CLARIFY, true))
+  expect(await out.find({ type: 'Text', text: /doesn't want to proceed/ })).toBeDefined()
+  await out.unmount()
+})
