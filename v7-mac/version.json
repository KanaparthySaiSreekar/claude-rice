{
  "tag": "v7",
  "label": "v7 on macOS: Six-tab right panel on the v2 Ember rice: Bridge, flightdeck, filetree, cockpit, paneline and cctop each open their pane, and Claude Code shows them as tabs; prismantis draws the chat with tool calls as collapsed rows on the right; the cctop program is installed here, so its pane has every view, and cctop pins nothing under the prompt (statusLine off: the rice status line shows each reading once); secret-box lets Claude use secrets without seeing them, loaded last so every other mod sees only placeholders",
  "plugins": {
    "aurora-bridge@kasasree-mods": true,
    "flightdeck@kasasree-mods": true,
    "filetree@kasasree-mods": true,
    "cockpit@kasasree-mods": true,
    "paneline@kasasree-mods": true,
    "cctop@kasasree-mods": true,
    "prismantis@kasasree-mods": true,
    "skins@kasasree-mods": false,
    "secret-box@kasasree-mods": true
  },
  "last": ["secret-box@kasasree-mods"],
  "options": {
    "aurora-bridge@kasasree-mods": { "openOnStart": true, "palette": "{palette:bridge}" },
    "flightdeck@kasasree-mods": { "openOnStart": true, "statusLine": false, "panels": "main,architect,gate,agents,loops,receipt,log" },
    "filetree@kasasree-mods": { "start": "on" },
    "paneline@kasasree-mods": { "autoOpen": true, "chat": false },
    "cctop@kasasree-mods": { "openOnStart": true, "announce": false, "statusLine": false },
    "cockpit@kasasree-mods": { "band": false, "statusLine": false },
    "prismantis@kasasree-mods": {
      "theme": "{palette}",
      "headingStyle": "bar",
      "codeStyle": "panel",
      "promptStyle": "bubble",
      "promptColor": "{palette:fg}",
      "declined": "quiet",
      "toolStyle": "chat",
      "toolOutput": "rows",
      "copyButtonStyle": "hover",
      "copyFeedback": "button",
      "diffAddedColor": "#98C25B",
      "diffRemovedColor": "#E8553C",
      "diffTint": "color",
      "diagramHints": false
    }
  },
  "settings": {
    "spinnerVerbs": {
      "mode": "replace",
      "verbs": ["Thinking", "Reading", "Working on it", "Checking", "Looking into it", "Writing", "Putting it together", "Testing", "Tidying up"]
    }
  }
}
